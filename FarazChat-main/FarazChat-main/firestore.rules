rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
    }

    match /messages/{messageId} {
      allow read: if signedIn() && (
        (resource.data.participants is list && request.auth.uid in resource.data.participants)
        || ('senderId' in resource.data && resource.data.senderId == request.auth.uid)
        || ('recipientId' in resource.data && resource.data.recipientId == request.auth.uid)
        || ('groupId' in resource.data
          && resource.data.groupId is string
          && isGroupMember(resource.data.groupId))
      );
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && (
          ('groupId' in request.resource.data
            && request.resource.data.groupId is string
            && isGroupMember(request.resource.data.groupId)
            && request.resource.data.participants is list
            && request.auth.uid in request.resource.data.participants)
          || ('recipientId' in request.resource.data
            && request.resource.data.recipientId is string
            && request.resource.data.recipientId != request.auth.uid
            && (!('participants' in request.resource.data)
              || (request.resource.data.participants is list
                && request.auth.uid in request.resource.data.participants
                && request.resource.data.recipientId in request.resource.data.participants)))
        );
      allow update: if signedIn()
        && 'recipientId' in resource.data
        && resource.data.recipientId == request.auth.uid
        && resource.data.senderId != request.auth.uid
        && (!('read' in resource.data) || resource.data.read == false)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.lastMessage is string;
      allow update: if signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants is list
        && resource.data.participants.size() == 2
        && request.resource.data.participants.size() == 2
        && resource.data.participants.hasAll(request.resource.data.participants)
        && request.resource.data.participants.hasAll(resource.data.participants)
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'updatedAt'])
        && request.resource.data.lastMessage is string;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt'])
          || (resource.data.createdBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'avatarBase64', 'updatedAt'])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 40
            && request.resource.data.bio is string
            && request.resource.data.bio.size() <= 240
            && request.resource.data.avatarBase64 is string
            && request.resource.data.avatarBase64.size() <= 800000)
          || (resource.data.createdBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.resource.data.memberIds is list
            && request.resource.data.memberIds.size() <= 50
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.resource.data.memberIds.hasAll(resource.data.memberIds))
          || (resource.data.createdBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.resource.data.memberIds is list
            && request.auth.uid in request.resource.data.memberIds
            && resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1
            && resource.data.memberIds.hasAll(request.resource.data.memberIds))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'createdBy'])
            && request.resource.data.memberIds is list
            && !(request.auth.uid in request.resource.data.memberIds)
            && resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1
            && resource.data.memberIds.hasAll(request.resource.data.memberIds)
            && ((resource.data.createdBy == request.auth.uid
                && request.resource.data.createdBy in request.resource.data.memberIds)
              || (resource.data.createdBy != request.auth.uid
                && request.resource.data.createdBy == resource.data.createdBy)))
        );
      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && resource.data.memberIds is list
        && resource.data.memberIds.size() == 1
        && request.auth.uid in resource.data.memberIds;
    }

    match /contacts/{contactId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /statuses/{statusId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'viewedBy', 'comments']);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}