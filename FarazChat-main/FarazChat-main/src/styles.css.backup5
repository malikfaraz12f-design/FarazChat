:root {
  font-family: 'DM Sans', sans-serif;
  color: #252a26;
  background: #f3f5f1;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  --ink: #252a26;
  --muted: #898f88;
  --brand: #1269e8;
  --brand-dark: #0b4fbe;
  --brand-pale: #eaf2ff;
  --line: #ecefe9;
  --paper: #fff;
}

html, body, #root { width: 100%; height: 100%; margin: 0; }
body { min-height: 100dvh; overflow: hidden; background: #f1f4f9; }
#root { min-height: 100dvh; }
* { box-sizing: border-box; }
button { color: inherit; }
button:focus-visible, input:focus-visible, textarea:focus-visible { outline: 3px solid #7cc6a7; outline-offset: 2px; }

.auth-page { min-height: 100vh; display: flex; flex-direction: column; padding: 0 8.15%; overflow-x: hidden; overflow-y: auto; background: radial-gradient(ellipse at 13% 82%, rgba(205, 230, 211, .38), transparent 32%), radial-gradient(ellipse at 87% 16%, rgba(239, 228, 196, .32), transparent 29%), #f7f8f5; }
.auth-topline { height: 82px; border-bottom: 1px solid rgba(34, 53, 40, .09); display: flex; align-items: center; justify-content: space-between; }
.brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); font: 800 19px 'Manrope', sans-serif; letter-spacing: 0; }
  .brand-light { font-weight: 500; color: #77869b; }
  .brand-mark-image { width: 34px; height: 34px; flex: 0 0 34px; object-fit: contain; }
.brand-mark { width: 31px; height: 31px; display: grid; place-items: center; border-radius: 10px 10px 10px 3px; background: #21835c; color: white; }
.private-note, .eyebrow, .inbox-kicker, .modal-kicker, .welcome-eyebrow { font-size: 10px; font-weight: 700; letter-spacing: 1px; }
.private-note { display: flex; align-items: center; gap: 7px; color: #747e75; letter-spacing: .8px; }
  .eyebrow { display: flex; align-items: center; gap: 9px; color: #57779f; letter-spacing: 1.1px; }
  .live-dot { display: inline-block; width: 7px; height: 7px; flex: 0 0 7px; border-radius: 50%; background: #38a8dc; }
.auth-content { width: min(1100px, 100%); flex: 1; min-height: 570px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(340px, .88fr); align-items: center; gap: 11%; padding: 52px 0 66px; }
.auth-copy { max-width: 500px; animation: rise-in .6s ease both; }
.eyebrow { display: flex; align-items: center; gap: 9px; color: #66816f; letter-spacing: 1.1px; }
  .auth-copy h1 span, .welcome-panel h2 span { color: #1269e8; }
  .auth-footnote svg { color: #3979d1; }
.auth-copy h1 span, .welcome-panel h2 span { color: #328866; }
.auth-copy > p { max-width: 418px; margin: 0; color: #777f78; font-size: 15px; line-height: 1.8; }
  .form-icon { width: 39px; height: 39px; display: grid; place-items: center; border-radius: 7px; background: #eaf2ff; color: #1269e8; }
.auth-footnote svg { color: #398663; }
.auth-form-wrap { width: 100%; max-width: 404px; padding: 31px 31px 25px; border: 1px solid rgba(44, 71, 53, .1); border-radius: 8px; background: rgba(255, 255, 255, .81); box-shadow: 0 18px 60px rgba(53, 71, 56, .065); animation: rise-in .6s .1s ease both; }
  .field-with-icon:focus-within, .search-field:focus-within { border-color: #78aaf4; }
.form-icon { width: 39px; height: 39px; display: grid; place-items: center; border-radius: 7px; background: #eaf3ec; color: #27825c; }
.auth-form-heading h2 { margin: 0 0 4px; font: 700 17px 'Manrope', sans-serif; }
  .profile-input:focus, .profile-textarea:focus { border-color: #78aaf4; }
.auth-form { display: flex; flex-direction: column; gap: 9px; padding-top: 23px; }
.auth-form label { margin-top: 3px; color: #545d55; font-size: 12px; font-weight: 600; }
.optional-label { margin-left: 5px; color: #9aa19a; font-size: 8px; letter-spacing: .5px; }
  .primary-button { height: 45px; display: inline-flex; align-items: center; justify-content: center; gap: 12px; border: 0; border-radius: 5px; background: #1269e8; color: white; font-size: 13px; font-weight: 600; cursor: pointer; transition: background .18s, transform .18s; }
  .primary-button:hover { background: #0b4fbe; transform: translateY(-1px); }
.field-with-icon:focus-within, .search-field:focus-within { border-color: #67a989; }
.field-with-icon input, .search-field input { width: 100%; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--ink); font-size: 13px; }
  .mode-switch button { padding: 0; border: 0; background: transparent; color: #1269e8; font-size: inherit; font-weight: 700; cursor: pointer; }
.profile-textarea { width: 100%; min-height: 96px; resize: vertical; padding: 11px 12px; border: 1px solid #e5e9e3; border-radius: 5px; outline: 0; background: #fff; color: var(--ink); font-size: 12px; line-height: 1.55; }
.profile-textarea::placeholder { color: #a3a9a2; }
  .auth-footer span:first-child { font-weight: 700; letter-spacing: 1.2px; color: #73839a; }
.signup-bio { min-height: 66px; }
.primary-button { height: 45px; display: inline-flex; align-items: center; justify-content: center; gap: 12px; border: 0; border-radius: 5px; background: #24835e; color: white; font-size: 13px; font-weight: 600; cursor: pointer; transition: background .18s, transform .18s; }
.primary-button:hover { background: #196d4c; transform: translateY(-1px); }
.primary-button:disabled { cursor: wait; opacity: .7; }
.auth-submit { width: 100%; margin-top: 11px; }
.auth-submit span { margin-left: auto; padding-right: 12px; font-size: 17px; }
.form-error { margin: 4px 0 0; color: #b34747; font-size: 12px; line-height: 1.5; }
.code-availability { min-height: 15px; margin: 4px 0 0; color: #71829a; text-align: center; font-size: 11px; line-height: 1.4; }
.code-availability-available { color: #187b4d; }
.code-availability-taken { color: #b34747; font-weight: 600; }
.code-availability-unavailable { color: #a56b16; }
.mode-switch { margin: 20px 0 0; color: #838a83; text-align: center; font-size: 12px; }
.mode-switch button { padding: 0; border: 0; background: transparent; color: #247d59; font-size: inherit; font-weight: 700; cursor: pointer; }
.auth-hint { margin: 12px 0 0; color: #9a9f98; text-align: center; font-size: 10px; }
.auth-footer { height: 59px; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(34, 53, 40, .09); color: #979e97; font-size: 9px; letter-spacing: .7px; }
.auth-footer span:first-child { font-weight: 700; letter-spacing: 1.2px; color: #768178; }

.messenger-shell { width: 100%; height: 100vh; min-height: 540px; display: grid; grid-template-columns: 340px minmax(0, 1fr); overflow: hidden; background: #f1f3ef; }
.messenger-shell { user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
.messenger-shell input, .messenger-shell textarea, .messenger-shell [contenteditable="true"] { user-select: text; -webkit-user-select: text; -webkit-touch-callout: default; }
.sidebar { min-width: 0; display: flex; flex-direction: column; background: #fff; border-right: 1px solid #e8ece6; z-index: 1; }
.sidebar-header { height: 69px; display: flex; align-items: center; justify-content: space-between; padding: 0 21px; border-bottom: 1px solid #eff1ee; }
.app-brand { gap: 8px; font-size: 17px; }
.app-brand .brand-mark { width: 28px; height: 28px; border-radius: 9px 9px 9px 3px; }
.header-actions { display: flex; align-items: center; gap: 5px; }
.header-actions .add-button, .chat-activity-button { display: none; }
.icon-button { width: 35px; height: 35px; display: grid; place-items: center; border: 0; border-radius: 5px; background: transparent; color: #778078; cursor: pointer; transition: background .15s, color .15s; }
.icon-button:hover { background: #f0f5f0; color: #267c58; }
.connection-indicator { width: 7px; height: 7px; margin-right: 5px; border-radius: 50%; background: #c4c8c3; }
.connection-indicator.is-online { background: #4cae79; box-shadow: 0 0 0 3px #e9f6ec; }
.inbox-title-row { display: flex; justify-content: space-between; align-items: end; padding: 25px 20px 16px; }
.inbox-kicker { color: #949b94; font-size: 9px; letter-spacing: 1.2px; }
.inbox-title-row h1 { margin: 5px 0 0; font: 700 21px 'Manrope', sans-serif; }
.inbox-title-row h1 span { padding-left: 4px; color: #9da49e; font: 500 12px 'DM Sans', sans-serif; }
.text-new-chat { display: inline-flex; align-items: center; gap: 4px; margin-bottom: 1px; padding: 7px 0 7px 7px; border: 0; background: transparent; color: #25805b; font-size: 11px; font-weight: 600; cursor: pointer; }
.text-new-chat:hover { color: #135d40; }
.search-field { height: 39px; display: flex; align-items: center; gap: 9px; padding: 0 11px; border: 1px solid transparent; border-radius: 5px; background: #f3f5f2; color: #89918a; transition: border-color .18s; }
.search-field input { font-size: 11px; }
.conversation-search { margin: 0 19px 12px; }
.conversation-search kbd { min-width: 18px; height: 19px; display: grid; place-items: center; border: 1px solid #e0e5de; border-radius: 3px; color: #979e96; background: white; font: 10px 'DM Sans', sans-serif; }
.conversation-list { flex: 1; overflow: auto; padding: 0 9px; }
.conversation-item { width: 100%; min-height: 70px; display: flex; align-items: center; gap: 11px; padding: 10px 10px; border: 0; border-radius: 5px; background: transparent; text-align: left; cursor: pointer; transition: background .16s; }
.conversation-item:hover { background: #f6f8f5; }
.conversation-item.conversation-active { background: #edf5ee; }
.avatar { width: 41px; height: 41px; flex: 0 0 41px; display: grid; place-items: center; border: 1px solid rgba(53, 96, 66, .1); border-radius: 50%; background: #e5efe5; color: #4e775c; font: 600 15px 'Manrope', sans-serif; }
.avatar > img { display: block; width: 100%; height: 100%; min-width: 0; min-height: 0; border-radius: inherit; object-fit: cover; object-position: center; }
.conversation-item:nth-child(4n + 2) .avatar, .result-user:nth-child(4n + 2) .avatar { background: #f1ece2; color: #94784c; }
.conversation-item:nth-child(4n + 3) .avatar, .result-user:nth-child(4n + 3) .avatar { background: #e9edf2; color: #667d98; }
.conversation-item:nth-child(4n + 4) .avatar, .result-user:nth-child(4n + 4) .avatar { background: #f2e9e7; color: #986d61; }
.conversation-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 6px; }
.conversation-top, .conversation-bottom { display: flex; align-items: center; justify-content: space-between; gap: 7px; }
.conversation-top strong { overflow: hidden; color: #323832; font-size: 12px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.conversation-top time { flex: 0 0 auto; color: #9aa19a; font-size: 9px; }
.conversation-bottom > span { overflow: hidden; color: #909790; font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
.inbox-empty { height: 240px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: #929991; }
.empty-art { width: 43px; height: 43px; display: grid; place-items: center; margin-bottom: 4px; border-radius: 14px 14px 14px 5px; background: #edf4ed; color: #6e9c7a; }
.inbox-empty strong { color: #586159; font-size: 12px; font-weight: 600; }
.inbox-empty > span:last-of-type { font-size: 10px; }
.inbox-empty button { margin-top: 5px; padding: 7px 9px; border: 1px solid #e3ebe2; border-radius: 4px; background: #fff; color: #2c805a; font-size: 10px; cursor: pointer; }
.inbox-empty button span { margin-left: 4px; }
.profile-footer { min-height: 67px; display: flex; align-items: center; gap: 10px; padding: 10px 20px; border-top: 1px solid #eff1ee; }
.profile-edit-button { width: 100%; border-right: 0; border-bottom: 0; border-left: 0; background: #fff; text-align: left; cursor: pointer; }
.profile-edit-button:hover { background: #f7f9f6; }
.profile-footer .avatar { width: 34px; height: 34px; flex-basis: 34px; font-size: 12px; }
.profile-name { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 4px; }
.profile-name strong { overflow: hidden; color: #424943; font-size: 11px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.profile-name > span { display: flex; align-items: center; gap: 5px; color: #909891; font-size: 9px; }
.profile-name .live-dot { width: 6px; height: 6px; flex-basis: 6px; }

.chat-panel { position: relative; min-width: 0; height: 100%; display: flex; flex-direction: column; overflow: hidden; background-color: #f4f5f2; background-image: radial-gradient(rgba(98, 123, 99, .08) .65px, transparent .65px); background-size: 21px 21px; }
.chat-header { height: 69px; flex: 0 0 69px; display: flex; align-items: center; gap: 11px; padding: 0 28px; border-bottom: 1px solid #e8ebe6; background: rgba(255, 255, 255, .94); }
.chat-header .avatar { width: 37px; height: 37px; flex-basis: 37px; font-size: 13px; }
.chat-contact { flex: 1; display: flex; flex-direction: column; gap: 4px; }
.chat-contact strong { color: #323832; font-size: 12px; font-weight: 600; }
.chat-contact span { display: flex; align-items: center; gap: 6px; color: #939a93; font-size: 10px; }
.chat-contact .live-dot { width: 6px; height: 6px; flex-basis: 6px; }
.chat-own-account { display: none !important; }
.chat-own-account .avatar { width: 30px; height: 30px; flex-basis: 30px; font-size: 10px; }
.chat-own-account > span { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.chat-own-account strong { max-width: 104px; overflow: hidden; color: #35473d; font-size: 9px; text-overflow: ellipsis; white-space: nowrap; }
.chat-own-account small { color: #849188; font-size: 8px; }
.message-stage { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 7px; padding: 22px clamp(18px, 7vw, 92px) 16px; }
.message-date { display: flex; justify-content: center; margin: 2px 0 18px; }
.message-date span { padding: 6px 10px; border: 1px solid rgba(224, 229, 221, .8); border-radius: 3px; background: rgba(255, 255, 255, .82); color: #9ba29b; font-size: 8px; font-weight: 600; letter-spacing: .8px; }
.first-message { display: flex; flex-direction: column; align-items: center; gap: 9px; margin: auto auto 24px; color: #929a92; text-align: center; font-size: 11px; }
.first-message .avatar-large { width: 54px; height: 54px; flex-basis: 54px; margin-bottom: 5px; font-size: 19px; }
.first-message strong { color: #555e56; font-size: 13px; font-weight: 600; }
.first-message-rule { width: 28px; height: 2px; margin-top: 7px; border-radius: 2px; background: #75ad83; }
.message-row { width: 100%; display: flex; align-items: end; gap: 7px; font-size: 15px; }
.message-row .avatar { width: 25px; height: 25px; flex-basis: 25px; font-size: 9px; }
.message-group-avatar { width: 25px; height: 25px; flex: 0 0 25px; }
.message-group-avatar .avatar { width: 25px; height: 25px; }
.message-row.message-mine { justify-content: flex-end; }
.message-stack { max-width: min(73%, 470px); display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
.message-mine .message-stack { align-items: flex-end; }
.message-content-frame { position: relative; max-width: 100%; }
.message-bubble { position: relative; padding: 10px 13px; border: 1px solid #dfe9e2; border-left: 3px solid #78a88a; border-radius: 4px 14px 14px 14px; background: #fcfefc; color: #222; -webkit-text-fill-color: currentColor; font-size: 15px; line-height: 1.6; opacity: 1; visibility: visible; white-space: pre-wrap; overflow-wrap: anywhere; box-shadow: 0 4px 12px rgba(35, 60, 45, .055); }
.message-mine .message-bubble { border-color: #f0c3c5; border-right: 3px solid #c94755; border-left-width: 1px; border-radius: 14px 4px 14px 14px; background: #fce6e7; color: #292020; }
.message-forwarded-label, .message-reply-quote { display: flex; align-items: center; gap: 4px; margin-bottom: 5px; color: #718096; font-size: 9px; }
.message-reply-quote { flex-direction: column; align-items: flex-start; max-width: 100%; padding-left: 7px; border-left: 2px solid #7b9ac1; }
.message-reply-quote span { overflow: hidden; max-width: 100%; text-overflow: ellipsis; white-space: nowrap; }
.message-edited-label { margin-left: 6px; color: #7f8793; font-size: 8px; }
.message-reactions { display: flex; flex-wrap: wrap; gap: 4px; margin-top: -1px; }
.message-reaction { display: inline-flex; align-items: center; gap: 4px; padding: 3px 6px; border: 1px solid #dce4ee; border-radius: 12px; background: #fff; font-size: 11px; cursor: pointer; }
.message-reaction.is-mine { border-color: #91acd0; background: #edf4ff; }
.message-reaction small { color: #68768a; font-size: 9px; }
.message-action-trigger { position: absolute; top: 1px; right: -29px; width: 25px; height: 25px; display: grid; place-items: center; border: 1px solid #e1e6ed; border-radius: 50%; background: #fff; color: #64748b; opacity: 0; cursor: pointer; transition: opacity .15s; }
.message-mine .message-action-trigger { right: auto; left: -29px; }
.message-row:hover .message-action-trigger, .message-action-trigger:focus-visible { opacity: 1; }
.message-action-menu { position: fixed; z-index: 1000; width: min(276px, calc(100vw - 20px)); display: flex; flex-direction: column; gap: 7px; padding: 7px; border: 1px solid #dce5dc; border-radius: 16px; background: rgba(255, 255, 255, .98); box-shadow: 0 12px 34px rgba(26, 49, 34, .2); animation: message-menu-in .12s ease-out; }
.message-reaction-picker { display: flex; align-items: center; justify-content: space-between; gap: 3px; padding: 4px; border: 1px solid #e8eee8; border-radius: 24px; background: #f3f7f3; }
.message-reaction-picker button { width: 36px; height: 36px; flex: 1 1 0; display: grid; place-items: center; padding: 0; border: 0; border-radius: 50%; background: transparent; font-size: 20px; cursor: pointer; transition: background .12s ease, transform .12s ease; -webkit-tap-highlight-color: transparent; }
.message-reaction-picker button:hover { transform: scale(1.12); background: #e4eee5; }
.message-action-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3px; }
.message-action-options > button { min-width: 0; min-height: 38px; display: flex; align-items: center; gap: 9px; padding: 0 10px; border: 0; border-radius: 10px; background: transparent; color: #394b40; text-align: left; font-size: 12px; font-weight: 600; cursor: pointer; }
.message-action-options > button:hover { background: #edf4ed; }
@keyframes message-menu-in { from { opacity: 0; transform: translateY(4px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
.message-composer-context { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 7px 18px; border-top: 1px solid #e8ebef; background: #f7f9fc; }
.message-composer-context > span { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.message-composer-context strong { color: #485970; font-size: 10px; }
.message-composer-context small { overflow: hidden; color: #7e8998; font-size: 9px; text-overflow: ellipsis; white-space: nowrap; }
.message-composer-context > button { border: 0; background: transparent; color: #738095; cursor: pointer; }
.chat-message-restriction { padding: 6px 14px; background: #fff5f5; color: #9d3c48; text-align: center; font-size: 10px; }
.message-time { display: inline-flex; align-items: center; gap: 3px; padding: 0 3px; color: #969d96; font-size: 8px; }
.message-read-receipt { display: inline-flex; align-items: center; gap: 2px; color: #8b999b; }
.message-read-receipt.is-delivered { color: #8b999b; }
.message-read-receipt.is-read { color: #e51c36; stroke: #e51c36; }
.message-read-receipt.is-read svg { color: #e51c36; stroke: #e51c36; }
.message-read-receipt small { font-size: 7px; }
.voice-note-player { width: min(310px, 100%); min-height: 54px; display: flex; align-items: center; gap: 10px; padding: 8px 10px; border: 1px solid #d8e7dc; border-radius: 8px 14px 14px 14px; background: #fbfefb; box-shadow: 0 3px 10px rgba(35, 60, 45, .05); }
.voice-note-player audio { display: none; }
.voice-play-button { width: 34px; height: 34px; flex: 0 0 34px; display: grid; place-items: center; padding: 0 0 0 2px; border: 0; border-radius: 50%; background: #268362; color: #fff; cursor: pointer; }
.message-mine .voice-note-player { border-color: #c4e2ce; border-radius: 14px 8px 14px 14px; background: #e1f3e7; }
.voice-note-track { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 3px; }
.voice-waveform { width: 100%; height: 30px; display: flex; align-items: center; gap: 2px; padding: 0; border: 0; background: transparent; cursor: pointer; }
.voice-waveform i, .recording-waveform i { min-width: 2px; flex: 1; border-radius: 2px; background: #9ab6a3; transition: background .12s, height .12s; }
.voice-waveform i.is-played { background: #27815d; }
.message-mine .voice-waveform i { background: #9cc5a8; }
.message-mine .voice-waveform i.is-played { background: #267b54; }
.voice-note-track > span { color: #718078; font-size: 9px; line-height: 1; }
.composer { min-height: 52px; display: flex; align-items: center; gap: 10px; margin: 0 clamp(14px, 5vw, 63px); padding: 5px 7px 5px 13px; border: 1px solid #e2e7e0; border-radius: 6px; background: #fff; box-shadow: 0 2px 8px rgba(46, 61, 48, .035); }
.composer-tool { width: 28px; height: 31px; display: grid; flex: 0 0 28px; place-items: center; border: 0; border-radius: 4px; background: transparent; color: #909990; cursor: pointer; }
.composer-tool:hover { color: #408663; background: #f1f6f0; }
.composer input { height: 38px; min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: #343b35; font-size: 12px; }
.composer input::placeholder { color: #a0a69f; }
.composer-divider { width: 1px; height: 21px; background: #ecefea; }
.composer-tool:disabled { cursor: not-allowed; opacity: .45; }
.voice-recording-status { min-height: 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 clamp(14px, 5vw, 63px) 6px; color: #b34747; font-size: 11px; font-weight: 600; }
.voice-recording-dot { width: 8px; height: 8px; border-radius: 50%; background: #d65353; animation: voice-pulse 1.2s ease-in-out infinite; }
.voice-recording-hint { flex: 1; color: #89919a; font-size: 10px; font-weight: 400; }
.recording-waveform { width: min(150px, 36vw); height: 25px; display: flex; align-items: center; gap: 2px; overflow: hidden; }
.recording-waveform i { background: #75a58a; }
.voice-cancel-pending .recording-waveform i { background: #a5abb2; }
.voice-recording-status button { min-height: 28px; padding: 0 8px; border: 1px solid #e6caca; border-radius: 4px; background: #fff; color: #a74141; font-size: 10px; cursor: pointer; }
.voice-record-button { touch-action: none; user-select: none; -webkit-user-select: none; }
.voice-record-button.voice-recording { background: #fff0f0; color: #c44343; }
.voice-cancel-pending .voice-recording-dot { background: #858d98; animation: none; }
@keyframes voice-pulse { 50% { opacity: .35; } }
.send-button { width: 34px; height: 34px; display: grid; flex: 0 0 34px; place-items: center; border: 0; border-radius: 4px; background: #27815d; color: #fff; cursor: pointer; transition: background .15s, opacity .15s; }
.send-button:hover { background: #186b4b; }
.send-button:disabled { background: #eff2ee; color: #a5aba4; cursor: default; }
.chat-privacy { height: 31px; display: flex; align-items: center; justify-content: center; gap: 5px; color: #969d96; font-size: 9px; }
.chat-privacy svg { color: #72907a; }
.chat-error { display: flex; align-items: center; justify-content: center; gap: 10px; padding: 8px; color: #a84646; font-size: 11px; }
.chat-error button { display: grid; place-items: center; border: 0; background: transparent; color: inherit; cursor: pointer; }
.welcome-panel { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; padding: 28px; text-align: center; animation: rise-in .55s ease both; }
.welcome-illustration { position: relative; width: 172px; height: 146px; display: grid; place-items: center; margin-bottom: 28px; }
.welcome-orbit { position: absolute; border: 1px solid rgba(111, 157, 120, .21); border-radius: 50%; transform: rotate(-17deg); }
.orbit-one { width: 148px; height: 82px; }
.orbit-two { width: 130px; height: 123px; transform: rotate(48deg); }
.welcome-icon { width: 73px; height: 73px; display: grid; place-items: center; border: 1px solid #d8e9dc; border-radius: 25px 25px 25px 7px; background: linear-gradient(145deg, #edf5eb, #e2eee1); color: #43825c; box-shadow: 0 9px 22px rgba(74, 116, 79, .1); transform: rotate(-5deg); }
.orbit-dot { position: absolute; width: 10px; height: 10px; border: 2px solid #f3f5f1; border-radius: 50%; background: #64a87b; }
.dot-one { top: 30px; right: 34px; }
.dot-two { bottom: 26px; left: 29px; width: 7px; height: 7px; background: #d2a966; }
.dot-three { top: 56px; left: 16px; width: 6px; height: 6px; background: #8cacc1; }
.welcome-eyebrow { color: #8c978e; font-size: 9px; letter-spacing: 1.4px; }
.welcome-panel h2 { margin: 12px 0 10px; color: #2c332d; font: 700 30px/1.3 'Manrope', sans-serif; }
.welcome-panel > p { max-width: 320px; margin: 0; color: #8b928b; font-size: 12px; line-height: 1.7; }
.welcome-button { margin-top: 24px; padding: 0 17px; }
.welcome-bottom { display: flex; align-items: center; gap: 5px; margin-top: 29px; color: #9aa199; font-size: 10px; }
.welcome-bottom svg { color: #539171; }

.modal-scrim { position: fixed; inset: 0; z-index: 5; display: grid; place-items: center; padding: 18px; background: rgba(31, 40, 32, .32); backdrop-filter: blur(3px); animation: fade-in .18s ease both; }
.new-chat-modal { width: min(436px, 100%); min-height: 335px; align-self: center; padding: 23px 23px 14px; border: 1px solid #e8ece5; border-radius: 7px; background: #fff; box-shadow: 0 22px 80px rgba(35, 49, 37, .2); animation: modal-in .2s ease both; }
.modal-heading { display: flex; align-items: start; justify-content: space-between; margin-bottom: 19px; }
.modal-kicker { color: #919a91; font-size: 9px; letter-spacing: 1px; }
.modal-heading h2 { margin: 5px 0 0; color: #2d342e; font: 700 21px 'Manrope', sans-serif; }
.profile-username { margin: 4px 0 0; color: #929a92; font-size: 11px; }
.profile-modal { min-height: auto; }
.profile-edit-form { display: flex; flex-direction: column; gap: 9px; }
.profile-edit-form label { margin-top: 3px; color: #545d55; font-size: 12px; font-weight: 600; }
.profile-input { height: 42px; padding: 0 11px; border: 1px solid #e5e9e3; border-radius: 5px; outline: 0; color: var(--ink); font-size: 12px; }
.profile-input:focus, .profile-textarea:focus { border-color: #67a989; }
.bio-counter { align-self: flex-end; margin-top: -4px; color: #9aa19a; font-size: 10px; }
.notification-setting { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-top: 7px; padding: 11px 12px; border: 1px solid #edf0eb; border-radius: 5px; background: #fafbf9; }
.notification-setting-copy { min-width: 0; display: flex; flex-direction: column; gap: 4px; }
.notification-setting-copy strong { color: #424943; font-size: 11px; font-weight: 600; }
.notification-setting-copy > span { color: #909891; font-size: 10px; line-height: 1.4; }
.profile-edit-form .switch-control { position: relative; width: 38px; height: 22px; flex: 0 0 38px; margin: 0; cursor: pointer; }
.switch-control input { position: absolute; width: 1px; height: 1px; overflow: hidden; opacity: 0; }
.switch-track { position: absolute; inset: 0; border-radius: 12px; background: #d7ddd6; transition: background .18s; }
.switch-track::after { position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(24, 46, 29, .2); content: ''; transition: transform .18s; }
.switch-control input:checked + .switch-track { background: #27815d; }
.switch-control input:checked + .switch-track::after { transform: translateX(16px); }
.switch-control input:focus-visible + .switch-track { outline: 3px solid #7cc6a7; outline-offset: 2px; }
.profile-save { width: 100%; margin-top: 6px; }
.modal-search { height: 43px; background: #f4f6f3; }
.modal-search input { font-size: 12px; }
.search-results { max-height: 290px; overflow: auto; }
.search-empty { min-height: 211px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: #929a92; text-align: center; }
.search-empty-icon { width: 43px; height: 43px; display: grid; place-items: center; margin-bottom: 3px; border-radius: 50%; background: #f0f5ef; color: #71967a; }
.search-empty strong { color: #586158; font-size: 12px; font-weight: 600; }
.search-empty > span:last-child { font-size: 10px; }
.search-error { padding-top: 15px; text-align: center; }
.result-user { width: 100%; display: flex; align-items: center; gap: 11px; padding: 10px 6px; border: 0; border-bottom: 1px solid #f0f2ef; background: white; text-align: left; cursor: pointer; }
.result-user:hover { background: #f7f9f6; }
.result-user .avatar { width: 38px; height: 38px; flex-basis: 38px; }
.result-user-name { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 4px; }
.result-user-name strong { overflow: hidden; color: #374039; font-size: 12px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.result-user-name span { display: -webkit-box; overflow: hidden; color: #9ba29b; font-size: 10px; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.result-arrow { padding: 7px; color: #679276; }
.loading-screen { height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 13px; color: #828b83; font-size: 12px; }
.loading-mark { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 14px 14px 14px 4px; background: #e7f1e6; color: #43835b; animation: breathe 1.4s ease-in-out infinite; }

.signup-photo-row { display: grid; grid-template-columns: 48px 1fr; align-items: center; gap: 2px 12px; margin: 3px 0 6px; }
.signup-photo-row .avatar { grid-row: span 2; width: 48px; height: 48px; flex-basis: 48px; }
.photo-pick-button { position: relative; width: fit-content; display: inline-flex; align-items: center; gap: 6px; padding: 7px 10px; border: 1px solid #d8e5f8; border-radius: 5px; background: #f5f8ff; color: #2366be; font-size: 11px; font-weight: 600; cursor: pointer; overflow: hidden; }
.photo-pick-button input, .photo-picker input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
.signup-photo-row > span { color: #929aa5; font-size: 9px; }
.settings-modal { width: min(740px, 100%); height: min(570px, calc(100dvh - 36px)); min-height: 400px; display: grid; grid-template-columns: 186px minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr) auto; overflow: hidden; border: 1px solid #dfe6f0; border-radius: 10px; background: #fff; box-shadow: 0 24px 90px rgba(12, 31, 65, .22); animation: modal-in .2s ease both; }
.settings-header { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; padding: 20px 24px 17px; border-bottom: 1px solid #e9edf3; background: linear-gradient(100deg, #f6f9ff, #fff 65%); }
.settings-header h2 { margin: 4px 0 2px; color: #1c2c47; font: 700 21px 'Manrope', sans-serif; }
.settings-header p { margin: 0; color: #8190a4; font-size: 11px; }
.settings-nav { display: flex; flex-direction: column; gap: 4px; padding: 17px 10px; border-right: 1px solid #e9edf3; background: #f8faff; }
.settings-nav-item { min-height: 40px; display: flex; align-items: center; gap: 10px; padding: 0 11px; border: 0; border-radius: 5px; background: transparent; color: #66768c; text-align: left; font-size: 12px; cursor: pointer; }
.settings-nav-item:hover { background: #edf3fc; color: #245caa; }
.settings-nav-active, .settings-nav-active:hover { background: #e8f0ff; color: #155fca; font-weight: 600; }
.settings-content { min-width: 0; overflow-y: auto; padding: 22px 27px; }
.settings-section-heading { margin-bottom: 19px; padding-bottom: 14px; border-bottom: 1px solid #edf0f4; }
.settings-section-heading h3 { margin: 5px 0 0; color: #28364b; font: 700 17px 'Manrope', sans-serif; }
.settings-form, .settings-panel { display: flex; flex-direction: column; gap: 13px; }
.photo-picker { position: relative; width: fit-content; display: flex; align-items: center; gap: 13px; margin: 0 0 4px; cursor: pointer; }
.photo-picker .avatar { width: 66px; height: 66px; flex-basis: 66px; font-size: 22px; }
.photo-picker > span { display: inline-flex; align-items: center; gap: 6px; padding: 8px 11px; border: 1px solid #d8e5f8; border-radius: 5px; background: #f5f8ff; color: #2366be; font-size: 11px; font-weight: 600; }
.settings-field { display: flex; flex-direction: column; gap: 6px; }
.settings-field > label { color: #4f5c6d; font-size: 11px; font-weight: 600; }
.settings-field .profile-textarea { min-height: 78px; }
.settings-field .bio-counter { margin-top: -19px; padding-right: 7px; pointer-events: none; }
.settings-save { align-self: flex-start; min-width: 154px; margin-top: 4px; padding: 0 15px; }
.settings-row, .account-identity { display: flex; align-items: center; gap: 12px; padding: 14px 13px; border: 1px solid #e9eef5; border-radius: 6px; background: #fbfcfe; }
.settings-row .notification-setting-copy, .account-identity .notification-setting-copy { flex: 1; }
.settings-row .notification-setting-copy strong, .account-identity .notification-setting-copy strong { color: #33445c; font-size: 12px; }
.settings-row .notification-setting-copy > span, .account-identity .notification-setting-copy > span { color: #75849a; font-size: 10px; line-height: 1.55; }
.setting-icon { width: 34px; height: 34px; flex: 0 0 34px; display: grid; place-items: center; border-radius: 7px; background: #edf4ff; color: #3570c2; }
.settings-panel .switch-control { position: relative; width: 38px; height: 22px; flex: 0 0 38px; cursor: pointer; }
.password-form { margin-top: 7px; padding-top: 16px; border-top: 1px solid #edf0f4; }
.password-form h4 { margin: 0; color: #35445a; font-size: 12px; font-weight: 600; }
.signout-button { min-height: 39px; display: flex; align-items: center; gap: 9px; margin-top: 7px; padding: 0 11px; border: 1px solid #f0dddd; border-radius: 5px; background: #fffafa; color: #a54343; text-align: left; font-size: 11px; font-weight: 600; cursor: pointer; }
.signout-button:hover { background: #fff1f1; }
.settings-feedback, .settings-success { margin: 7px 0 0; font-size: 11px; }
.settings-success { color: #286eaf; }
.settings-footer { grid-column: 1 / -1; padding: 10px 16px; border-top: 1px solid #e9edf3; color: #98a3b3; text-align: right; font-size: 9px; }

@keyframes rise-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes modal-in { from { opacity: 0; transform: translateY(8px) scale(.99); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes breathe { 50% { transform: scale(.94); opacity: .7; } }

@media (min-width: 1200px) { .messenger-shell { grid-template-columns: 370px minmax(0, 1fr); } }
@media (max-width: 760px) {
  .auth-page { padding: 0 22px; }
  .auth-topline { height: 67px; }
  .auth-content { min-height: auto; grid-template-columns: 1fr; gap: 30px; padding: 48px 0; }
  .auth-copy h1 { margin: 17px 0 11px; font-size: clamp(36px, 8vw, 48px); }
  .auth-copy > p { font-size: 13px; }
  .auth-footnote { margin-top: 19px; font-size: 10px; }
  .auth-form-wrap { max-width: none; padding: 23px 21px 19px; }
  .auth-footer { gap: 10px; font-size: 8px; }
  .auth-footer span:nth-child(2) { display: none; }
  .messenger-shell { position: relative; display: block; }
  .sidebar, .chat-panel { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sidebar-hidden-mobile { display: none; }
  .chat-panel:not(.chat-mobile-visible) { display: none; }
  .chat-mobile-visible { display: flex; }
  .chat-header { height: 62px; flex-basis: 62px; gap: 8px; padding: 0 13px; }
  .back-button { display: grid; width: 31px; margin-left: -7px; }
  .message-stage { padding: 19px 15px 13px; }
  .composer { margin: 0 10px; }
  .welcome-panel h2 { font-size: 27px; }
  .modal-scrim { align-items: end; padding: 0; }
  .new-chat-modal { width: 100%; min-height: 390px; padding: 22px 20px 12px; border-radius: 11px 11px 0 0; }
  .search-results { max-height: 43vh; }
}
@media (min-width: 761px) { .back-button { display: none; } }
@media (max-height: 680px) and (min-width: 761px) { .auth-content { padding-top: 30px; padding-bottom: 30px; } .auth-copy h1 { font-size: 43px; } .auth-footnote { margin-top: 26px; } }

:root {
  --brand: #1269e8;
  --brand-dark: #0b4fbe;
  --brand-pale: #eaf2ff;
  background: #f3f6fb;
}
.auth-page { background: radial-gradient(ellipse at 13% 82%, rgba(210, 228, 255, .55), transparent 34%), radial-gradient(ellipse at 87% 16%, rgba(218, 242, 250, .5), transparent 30%), #f7f9fd; }
.messenger-shell { background: #f1f4f9; }
.brand-light { color: #77869b; }
.brand-mark-image { width: 34px; height: 34px; flex: 0 0 34px; object-fit: contain; }
.app-brand .brand-mark-image { width: 31px; height: 31px; flex-basis: 31px; }
.eyebrow { color: #57779f; }
.live-dot, .connection-indicator.is-online { background: #38a8dc; }
.auth-copy h1 span, .welcome-panel h2 span { color: #1269e8; }
.auth-footnote svg, .form-icon, .welcome-icon { color: #1269e8; }
.form-icon { background: #eaf2ff; }
.field-with-icon:focus-within, .search-field:focus-within, .profile-input:focus, .profile-textarea:focus { border-color: #78aaf4; }
.primary-button, .send-button { background: #1269e8; }
.primary-button:hover, .send-button:hover { background: #0b4fbe; }
.mode-switch button, .text-new-chat, .inbox-empty button { color: #1269e8; }
.text-new-chat:hover, .inbox-empty button:hover { color: #0b4fbe; }
.icon-button:hover { background: #edf4ff; color: #1269e8; }
.connection-indicator.is-online { box-shadow: 0 0 0 3px #e8f2ff; }
.conversation-item.conversation-active { background: #edf4ff; }
.avatar { border-color: rgba(35, 89, 164, .13); background: #e7f0ff; color: #315f9f; }
.welcome-icon { border-color: #d8e6fa; background: linear-gradient(145deg, #edf5ff, #e2edff); box-shadow: 0 9px 22px rgba(53, 105, 181, .1); }
.welcome-orbit { border-color: rgba(79, 128, 197, .22); }
.orbit-dot { background: #5593ea; }
.dot-two { background: #45b7df; }
.dot-three { background: #97a9d4; }
.first-message-rule, .switch-control input:checked + .switch-track { background: #1269e8; }
.search-empty-icon { background: #edf4ff; color: #5281c0; }
.message-stage { background-color: #eef2f8; background-image: radial-gradient(rgba(76, 99, 132, .075) .65px, transparent .65px); }
.auth-form-wrap { border-color: rgba(41, 81, 143, .12); }
.brand-mark-image { width: 40px; height: 40px; }
.app-brand .brand-mark-image { width: 35px; height: 35px; flex-basis: 35px; }
.search-field:focus-within { border-color: #78aaf4; }
.profile-textarea:focus, .profile-input:focus { border-color: #78aaf4; }
.composer:focus-within { border-color: #84aff0; box-shadow: 0 0 0 3px rgba(36, 105, 210, .08); }
.composer-tool:hover { color: #1269e8; background: #edf4ff; }
.message-mine .message-time svg, .chat-privacy svg, .welcome-bottom svg { color: #3979d1; }
.auth-form-wrap .mode-switch button { color: #1269e8; }
.settings-modal .modal-kicker { color: #5778a4; }
.profile-modal .settings-row .switch-control input:checked + .switch-track { background: #1269e8; }
.chat-panel { background-color: #f2f6f3; background-image: radial-gradient(rgba(53, 105, 79, .075) .65px, transparent .65px); }

.message-stage.wallpaper-paper { background-color: #eef2f8; background-image: radial-gradient(rgba(76, 99, 132, .075) .65px, transparent .65px); }
.message-stage.wallpaper-grid { background-color: #f3f6f4; background-image: linear-gradient(rgba(78, 115, 94, .055) 1px, transparent 1px), linear-gradient(90deg, rgba(78, 115, 94, .055) 1px, transparent 1px); background-size: 24px 24px; }
.message-stage.wallpaper-sage { background-color: #edf4ec; background-image: radial-gradient(ellipse at 20% 20%, rgba(145, 184, 146, .17), transparent 38%), radial-gradient(ellipse at 82% 74%, rgba(117, 166, 142, .13), transparent 34%); }

.wallpaper-settings { display: flex; flex-direction: column; gap: 18px; }
.wallpaper-choices { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 9px; }
.wallpaper-choice { min-width: 0; display: flex; flex-direction: column; gap: 8px; padding: 7px; border: 1px solid #e1e8e2; border-radius: 6px; background: #fff; color: #54655a; text-align: left; cursor: pointer; }
.wallpaper-choice.is-selected { border-color: #398963; box-shadow: 0 0 0 2px rgba(57, 137, 99, .13); }
.wallpaper-choice strong { overflow: hidden; font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
.wallpaper-swatch { width: 100%; aspect-ratio: 1.7; border-radius: 4px; background-color: #eef2f8; background-image: radial-gradient(rgba(76, 99, 132, .11) .8px, transparent .8px); background-size: 10px 10px; }
.wallpaper-choice-grid .wallpaper-swatch { background-color: #f3f6f4; background-image: linear-gradient(rgba(78, 115, 94, .12) 1px, transparent 1px), linear-gradient(90deg, rgba(78, 115, 94, .12) 1px, transparent 1px); background-size: 12px 12px; }
.wallpaper-choice-sage .wallpaper-swatch { background-color: #edf4ec; background-image: radial-gradient(ellipse at 25% 25%, rgba(145, 184, 146, .45), transparent 40%), radial-gradient(ellipse at 76% 74%, rgba(117, 166, 142, .35), transparent 38%); }
.wallpaper-actions { display: flex; align-items: center; gap: 9px; }
.empty-art { background: #edf4ff; color: #5684c2; }
.result-arrow { color: #3472c5; }
button:focus-visible, input:focus-visible, textarea:focus-visible { outline-color: #6ea5f5; }
.auth-copy h1 { font-size: 52px; }

@media (max-width: 600px) {
  .settings-modal { width: 100%; height: min(650px, calc(100dvh - 8px)); min-height: 420px; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto minmax(0, 1fr) auto; border-radius: 12px 12px 0 0; }
  .settings-header { padding: 15px 18px 12px; }
  .settings-nav { flex-direction: row; gap: 3px; overflow-x: auto; padding: 7px; border-right: 0; border-bottom: 1px solid #e9edf3; }
  .settings-nav-item { min-height: 36px; flex: 1 0 auto; justify-content: center; gap: 6px; padding: 0 9px; font-size: 10px; white-space: nowrap; }
  .settings-content { padding: 16px 17px; }
  .settings-section-heading { margin-bottom: 14px; }
  .settings-footer { padding: 8px 12px; }
  .signup-photo-row { margin-bottom: 2px; }
  .auth-form-wrap { padding: 21px 18px 17px; }
}
@media (max-width: 760px) { .auth-copy h1 { font-size: 39px; } }
@media (max-height: 680px) and (min-width: 761px) { .auth-copy h1 { font-size: 43px; } }

.messenger-shell[data-theme="dark"] {
  color: #e6edf7;
  background: #0e1623;
  color-scheme: dark;
}
.messenger-shell[data-theme="dark"] .sidebar { border-color: #26354a; background: #141f2e; }
.messenger-shell[data-theme="dark"] .sidebar-header,
.messenger-shell[data-theme="dark"] .profile-footer,
.messenger-shell[data-theme="dark"] .chat-header { border-color: #26354a; background: #141f2e; }
.messenger-shell[data-theme="dark"] .brand,
.messenger-shell[data-theme="dark"] .inbox-title-row h1,
.messenger-shell[data-theme="dark"] .conversation-top strong,
.messenger-shell[data-theme="dark"] .profile-name strong,
.messenger-shell[data-theme="dark"] .chat-contact strong,
.messenger-shell[data-theme="dark"] .welcome-panel h2 { color: #e7edf7; }
.messenger-shell[data-theme="dark"] .brand-light,
.messenger-shell[data-theme="dark"] .conversation-top time,
.messenger-shell[data-theme="dark"] .conversation-bottom > span,
.messenger-shell[data-theme="dark"] .profile-name > span,
.messenger-shell[data-theme="dark"] .chat-contact span,
.messenger-shell[data-theme="dark"] .welcome-panel > p,
.messenger-shell[data-theme="dark"] .welcome-bottom { color: #9aaac0; }
.messenger-shell[data-theme="dark"] .inbox-kicker,
.messenger-shell[data-theme="dark"] .modal-kicker,
.messenger-shell[data-theme="dark"] .welcome-eyebrow { color: #8da4c5; }
.messenger-shell[data-theme="dark"] .search-field,
.messenger-shell[data-theme="dark"] .conversation-search kbd { border-color: #293950; background: #1a283a; color: #aab9ce; }
.messenger-shell[data-theme="dark"] .search-field input,
.messenger-shell[data-theme="dark"] .composer input { color: #e6edf7; }
.messenger-shell[data-theme="dark"] .search-field input::placeholder,
.messenger-shell[data-theme="dark"] .composer input::placeholder { color: #8495ac; }
.messenger-shell[data-theme="dark"] .conversation-item:hover { background: #19273a; }
.messenger-shell[data-theme="dark"] .conversation-item.conversation-active { background: #1a3353; }
.messenger-shell[data-theme="dark"] .avatar { border-color: #31445d; background: #263c58; color: #c5dcff; }
.messenger-shell[data-theme="dark"] .chat-panel { background-color: #101a29; background-image: radial-gradient(rgba(120, 157, 210, .09) .65px, transparent .65px); }
.messenger-shell[data-theme="dark"] .message-date span { border-color: #293950; background: #1a283a; color: #a0b0c7; }
.messenger-shell[data-theme="dark"] .first-message,
.messenger-shell[data-theme="dark"] .message-time,
.messenger-shell[data-theme="dark"] .chat-privacy { color: #93a3ba; }
.messenger-shell[data-theme="dark"] .first-message strong { color: #d5dfed; }
.messenger-shell[data-theme="dark"] .message-bubble { border-color: #2b3b51; background: #1a283a; color: #e2eaf5; }
.messenger-shell[data-theme="dark"] .message-mine .message-bubble { border-color: #70404a; background: #3a252d; color: #fae9eb; }
.messenger-shell[data-theme="dark"] .chat-own-account { border-color: #30425b; background: #1a283a; }
.messenger-shell[data-theme="dark"] .chat-own-account strong { color: #e1eaf7; }
.messenger-shell[data-theme="dark"] .chat-own-account small { color: #9eafc5; }
.messenger-shell[data-theme="dark"] .voice-note-player { border-color: #304a3b; background: #182b22; }
.messenger-shell[data-theme="dark"] .message-mine .voice-note-player { border-color: #286448; background: #193b2c; }
.messenger-shell[data-theme="dark"] .voice-play-button { background: #2c9a6c; }
.messenger-shell[data-theme="dark"] .voice-waveform i { background: #597965; }
.messenger-shell[data-theme="dark"] .voice-waveform i.is-played { background: #72c394; }
.messenger-shell[data-theme="dark"] .voice-note-track > span { color: #a7bbaE; }
.messenger-shell[data-theme="dark"] .message-stage.wallpaper-paper { background-color: #101a29; background-image: radial-gradient(rgba(120, 157, 210, .09) .65px, transparent .65px); }
.messenger-shell[data-theme="dark"] .message-stage.wallpaper-grid { background-color: #101a29; background-image: linear-gradient(rgba(120, 157, 210, .075) 1px, transparent 1px), linear-gradient(90deg, rgba(120, 157, 210, .075) 1px, transparent 1px); }
.messenger-shell[data-theme="dark"] .message-stage.wallpaper-sage { background-color: #14251e; background-image: radial-gradient(ellipse at 20% 20%, rgba(61, 113, 76, .2), transparent 38%), radial-gradient(ellipse at 82% 74%, rgba(49, 111, 81, .17), transparent 34%); }
.messenger-shell[data-theme="dark"] 
.messenger-shell[data-theme="dark"] .wallpaper-choice { border-color: #30425b; background: #19273a; color: #d3dfed; }
.messenger-shell[data-theme="dark"] .wallpaper-choice.is-selected { border-color: #57a77e; }
.messenger-shell[data-theme="dark"] .message-read-receipt.is-delivered { color: #9aa9a6; }
.messenger-shell[data-theme="dark"] .message-read-receipt.is-read { color: #ff334b; stroke: #ff334b; }
.messenger-shell[data-theme="dark"] .message-read-receipt.is-read svg { color: #ff334b; stroke: #ff334b; }
.messenger-shell[data-theme="dark"] .composer { border-color: #2b3b51; background: #172437; }
.messenger-shell[data-theme="dark"] .composer-divider { background: #2b3b51; }
.messenger-shell[data-theme="dark"] .send-button:disabled { background: #26364b; color: #9aabc2; }
.messenger-shell[data-theme="dark"] .welcome-icon { border-color: #2b4567; background: linear-gradient(145deg, #1c3453, #182b45); color: #79aaff; }
.messenger-shell[data-theme="dark"] .welcome-orbit { border-color: rgba(113, 159, 223, .26); }
.messenger-shell[data-theme="dark"] .settings-modal,
.messenger-shell[data-theme="dark"] .new-chat-modal { border-color: #2a3b53; background: #152132; color: #e5edf8; }
.messenger-shell[data-theme="dark"] .settings-header { border-color: #2a3b53; background: linear-gradient(100deg, #1a2a40, #152132 70%); }
.messenger-shell[data-theme="dark"] .settings-header h2,
.messenger-shell[data-theme="dark"] .modal-heading h2,
.messenger-shell[data-theme="dark"] .settings-section-heading h3 { color: #e5edf8; }
.messenger-shell[data-theme="dark"] .settings-header p,
.messenger-shell[data-theme="dark"] .profile-username { color: #9badc6; }
.messenger-shell[data-theme="dark"] .settings-nav { border-color: #2a3b53; background: #111c2b; }
.messenger-shell[data-theme="dark"] .settings-nav-item { color: #a6b5ca; }
.messenger-shell[data-theme="dark"] .settings-nav-item:hover,
.messenger-shell[data-theme="dark"] .settings-nav-active,
.messenger-shell[data-theme="dark"] .settings-nav-active:hover { background: #203957; color: #b8d5ff; }
.messenger-shell[data-theme="dark"] .settings-content,
.messenger-shell[data-theme="dark"] .settings-section-heading,
.messenger-shell[data-theme="dark"] .password-form { border-color: #2a3b53; }
.messenger-shell[data-theme="dark"] .settings-section-heading h3,
.messenger-shell[data-theme="dark"] .password-form h4 { color: #e1eaf7; }
.messenger-shell[data-theme="dark"] .settings-field > label { color: #bdcadd; }
.messenger-shell[data-theme="dark"] .profile-input,
.messenger-shell[data-theme="dark"] .profile-textarea,
.messenger-shell[data-theme="dark"] .field-with-icon,
.messenger-shell[data-theme="dark"] .modal-search { border-color: #30425b; background: #101b2a; color: #e5edf8; }
.messenger-shell[data-theme="dark"] .profile-input::placeholder,
.messenger-shell[data-theme="dark"] .profile-textarea::placeholder { color: #8192aa; }
.messenger-shell[data-theme="dark"] .settings-row,
.messenger-shell[data-theme="dark"] .account-identity { border-color: #2a3b53; background: #19273a; }
.messenger-shell[data-theme="dark"] .settings-row .notification-setting-copy strong,
.messenger-shell[data-theme="dark"] .account-identity .notification-setting-copy strong { color: #e1eaf7; }
.messenger-shell[data-theme="dark"] .settings-row .notification-setting-copy > span,
.messenger-shell[data-theme="dark"] .account-identity .notification-setting-copy > span { color: #9eafc5; }
.messenger-shell[data-theme="dark"] .setting-icon { background: #203a5d; color: #8db9ff; }
.messenger-shell[data-theme="dark"] .photo-picker > span,
.messenger-shell[data-theme="dark"] .photo-pick-button { border-color: #38547a; background: #1c304b; color: #aaccff; }
.messenger-shell[data-theme="dark"] .settings-footer { border-color: #2a3b53; color: #8799b2; }
.messenger-shell[data-theme="dark"] .search-empty,
.messenger-shell[data-theme="dark"] .search-empty strong { color: #bac8da; }
.messenger-shell[data-theme="dark"] .result-user { border-color: #293950; background: #152132; }
.messenger-shell[data-theme="dark"] .result-user:hover { background: #1a2a40; }
.messenger-shell[data-theme="dark"] .result-user-name strong { color: #e3ebf6; }
.messenger-shell[data-theme="dark"] .result-user-name span { color: #9bacc2; }
.messenger-shell[data-theme="dark"] .signout-confirm { border-color: #5d3d4c; background: #2b202e; }
.messenger-shell[data-theme="dark"] .signout-confirm strong { color: #f1dfe7; }
.messenger-shell[data-theme="dark"] .signout-confirm span { color: #c3aebb; }
.conversation-avatar-wrap { position: relative; flex: 0 0 41px; width: 41px; height: 41px; }
.conversation-avatar-wrap .avatar { width: 100%; height: 100%; }
.presence-dot { position: absolute; right: 0; bottom: 0; width: 11px; height: 11px; border: 2px solid #fff; border-radius: 50%; background: #33a6df; }
.conversation-online-label { flex: 0 0 auto; color: #3888ce; font-size: 9px; font-style: normal; }
.contact-profile-trigger { min-width: 0; flex: 1; display: flex; align-items: center; gap: 11px; padding: 0; border: 0; background: transparent; text-align: left; cursor: pointer; }
.contact-profile-trigger:hover .chat-contact strong { color: #1269e8; }
.contact-status { display: inline-flex; align-items: center; gap: 6px; color: #8995a5; font-size: 10px; }
.contact-status i { width: 6px; height: 6px; border-radius: 50%; background: #aeb7c3; }
.contact-status.is-online i { background: #35a6dd; }
.typing-dots { display: inline-flex; align-items: center; gap: 3px; }
.typing-dots i { width: 4px; height: 4px; border-radius: 50%; background: currentColor; animation: typing-bounce .8s infinite alternate; }
.typing-dots i:nth-child(2) { animation-delay: .16s; }
.typing-dots i:nth-child(3) { animation-delay: .32s; }
@keyframes typing-bounce { to { transform: translateY(-3px); opacity: .45; } }
.message-attachment-image { max-width: min(340px, 72vw); display: block; overflow: hidden; border: 1px solid #dbe4f0; border-radius: 8px; background: #edf2f8; }
.message-attachment-image img { display: block; width: auto; max-width: 100%; max-height: 340px; object-fit: contain; }
.message-attachment-media { width: min(340px, 72vw); max-height: 280px; border-radius: 7px; background: #111; }
.message-file, .attachment-loading, .attachment-unavailable { max-width: min(340px, 76vw); display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid #dce5f1; border-radius: 7px; background: #fff; color: #465873; text-decoration: none; }
.message-mine .message-file, .message-mine .attachment-loading { border-color: #cfe0f8; background: #f5f8fe; }
.message-file > span:nth-child(2), .attachment-draft > span { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 4px; }
.message-file strong, .attachment-draft strong { max-width: 220px; overflow: hidden; color: #344761; font-size: 11px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.message-file small, .attachment-draft small { color: #8593a7; font-size: 9px; }
.file-icon { width: 32px; height: 32px; flex: 0 0 32px; display: grid; place-items: center; border-radius: 5px; background: #eaf2ff; color: #3473c5; }
.attachment-loading, .attachment-unavailable { color: #8491a2; font-size: 10px; }
.attachment-draft { width: fit-content; max-width: min(360px, calc(100% - 28px)); min-height: 48px; display: flex; align-items: center; gap: 9px; margin: 0 clamp(14px, 5vw, 63px) 7px; padding: 6px 8px 6px 11px; border: 1px solid #dce5f1; border-radius: 6px; background: #fff; color: #3473c5; }
.hidden-file-input { display: none; }
.contact-profile-modal { position: relative; width: min(370px, 100%); display: flex; flex-direction: column; align-items: center; padding: 34px 25px 25px; border: 1px solid #dfe6f0; border-radius: 9px; background: #fff; text-align: center; box-shadow: 0 24px 90px rgba(12, 31, 65, .22); animation: modal-in .2s ease both; }
.contact-profile-modal > .avatar { width: 88px; height: 88px; flex-basis: 88px; font-size: 29px; }
.contact-profile-modal h2 { margin: 15px 0 4px; color: #253750; font: 700 21px 'Manrope', sans-serif; }
.contact-profile-username { color: #8190a4; font-size: 12px; }
.contact-profile-status { display: flex; align-items: center; gap: 6px; margin-top: 12px; color: #8795a8; font-size: 10px; }
.contact-profile-status i { width: 6px; height: 6px; border-radius: 50%; background: #aeb7c3; }
.contact-profile-status.contact-is-online i { background: #35a6dd; }
.contact-profile-modal p { width: 100%; margin: 17px 0 0; padding-top: 15px; border-top: 1px solid #edf0f4; color: #64748a; font-size: 12px; line-height: 1.6; overflow-wrap: anywhere; }
.contact-profile-close { position: absolute; top: 10px; right: 10px; }
.messenger-shell[data-theme="dark"] .presence-dot { border-color: #141f2e; }
.messenger-shell[data-theme="dark"] .conversation-online-label { color: #79baff; }
.messenger-shell[data-theme="dark"] .contact-profile-modal { border-color: #2a3b53; background: #152132; }
.messenger-shell[data-theme="dark"] .contact-profile-modal h2 { color: #e5edf8; }
.messenger-shell[data-theme="dark"] .contact-profile-username,
.messenger-shell[data-theme="dark"] .contact-profile-modal p { color: #9eafc5; }
.messenger-shell[data-theme="dark"] .contact-profile-modal p { border-color: #2a3b53; }
.messenger-shell[data-theme="dark"] .message-file,
.messenger-shell[data-theme="dark"] .attachment-loading { border-color: #2b3b51; background: #1a283a; color: #afc5e2; }
.messenger-shell[data-theme="dark"] .message-file strong,
.messenger-shell[data-theme="dark"] .attachment-draft strong { color: #dce8f8; }
.messenger-shell[data-theme="dark"] .message-file small,
.messenger-shell[data-theme="dark"] .attachment-draft small { color: #9bacbf; }
.messenger-shell[data-theme="dark"] .attachment-draft { border-color: #2b3b51; background: #172437; }
.messenger-shell[data-theme="dark"] .message-attachment-image { border-color: #2b3b51; background: #101a29; }

.inbox-tabs { display: flex; gap: 3px; margin: 0 14px 12px; padding: 3px; border: 1px solid #e5eaf2; border-radius: 7px; background: #f5f7fb; }
.inbox-tabs button { min-height: 31px; flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 5px; padding: 0 7px; border: 0; border-radius: 5px; background: transparent; color: #748196; font-size: 10px; font-weight: 600; cursor: pointer; }
.inbox-tabs button:hover { color: #2566bc; }
.inbox-tabs button.inbox-tab-active { background: #fff; color: #1f5eaf; box-shadow: 0 1px 4px rgba(31, 56, 92, .1); }
.inbox-tabs button span { color: #98a5b7; font-size: 9px; }
.status-list { padding: 3px 7px 10px; }
.status-list-item { width: 100%; min-height: 68px; display: flex; align-items: center; gap: 11px; padding: 8px 10px; border: 0; border-radius: 6px; background: transparent; text-align: left; cursor: pointer; }
.status-list-item:hover { background: #f5f8fc; }
.status-list-item > span:nth-child(2) { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 5px; }
.status-list-item strong { overflow: hidden; color: #34445b; font-size: 11px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.status-list-item small { overflow: hidden; color: #8996a8; font-size: 9px; text-overflow: ellipsis; white-space: nowrap; }
.status-ring { position: relative; width: 48px; height: 48px; flex: 0 0 48px; display: grid; place-items: center; border: 2px solid #aeb9c8; border-radius: 50%; }
.status-ring > .avatar { width: 40px; height: 40px; flex-basis: 40px; }
.status-ring.status-unviewed { border: 2px solid transparent; background: conic-gradient(#1ab5d1, #0c69e5, #1ab5d1) border-box; }
.status-ring.status-unviewed::before { position: absolute; inset: 2px; border: 2px solid #fff; border-radius: 50%; content: ''; }
.status-ring.status-unviewed > .avatar { width: 36px; height: 36px; flex-basis: 36px; }
.status-add-ring { border-color: #c4cedb; }
.status-add-ring > i { position: absolute; right: -3px; bottom: -3px; width: 19px; height: 19px; display: grid; place-items: center; border: 2px solid #fff; border-radius: 50%; background: #1269e8; color: #fff; font-size: 15px; font-style: normal; line-height: 1; }
.status-add-control { width: 29px; height: 29px; display: grid; place-items: center; border: 1px solid #dfe7f1; border-radius: 50%; color: #407bc4; }
.group-avatar { width: 41px; height: 41px; flex: 0 0 41px; display: grid; place-items: center; border-radius: 50%; background: #e7f0ff; color: #2866ad; }
.chat-group-avatar { width: 37px; height: 37px; flex-basis: 37px; }
.group-message-author { margin-left: 3px; color: #4c78ad; font-size: 9px; font-weight: 600; }
.group-create-form { display: flex; flex-direction: column; gap: 9px; }
.group-create-form > label:not(.search-field) { color: #4f5c6d; font-size: 11px; font-weight: 600; }
.group-search { margin: 2px 0; }
.group-selected { min-height: 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
.group-selected > strong { width: 100%; color: #7d8b9d; font-size: 10px; font-weight: 600; }
.group-selected > button { display: inline-flex; align-items: center; gap: 5px; padding: 5px 7px; border: 1px solid #dce7f6; border-radius: 15px; background: #f3f7fd; color: #3d6597; font-size: 9px; cursor: pointer; }
.group-user-results { max-height: 235px; overflow-y: auto; border-top: 1px solid #edf0f5; }
.group-search-hint { display: block; padding: 17px 5px; color: #8996a8; text-align: center; font-size: 10px; }
.group-user-result { width: 100%; min-height: 55px; display: flex; align-items: center; gap: 9px; padding: 7px 5px; border: 0; border-bottom: 1px solid #edf0f5; background: transparent; text-align: left; cursor: pointer; }
.group-user-result:hover, .group-user-result.is-selected { background: #f2f7ff; }
.group-user-result .avatar { width: 36px; height: 36px; flex-basis: 36px; }
.group-user-result > span:nth-child(2) { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 3px; }
.group-user-result strong { overflow: hidden; color: #35465d; font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
.group-user-result small { color: #8795a8; font-size: 9px; }
.member-check { width: 20px; height: 20px; display: grid; place-items: center; border: 1px solid #d5dfeb; border-radius: 50%; color: #7e8da1; font-size: 12px; }
.group-user-result.is-selected .member-check { border-color: #1269e8; background: #1269e8; color: #fff; }
.group-create-submit { width: 100%; }
.group-details-icon { width: 76px; height: 76px; display: grid; place-items: center; border-radius: 50%; background: #eaf2ff; color: #286ab8; }
.group-details-modal { max-height: min(720px, calc(100dvh - 32px)); overflow-y: auto; }
.group-details-profile { display: flex; flex-direction: column; align-items: center; gap: 7px; margin: 10px 0 16px; text-align: center; }
.group-details-profile .avatar-large { width: 76px; height: 76px; flex-basis: 76px; font-size: 25px; }
.group-details-profile h2 { margin: 2px 0 0; }
.group-details-profile p { max-width: 380px; margin: 0; color: #758294; font-size: 11px; line-height: 1.5; overflow-wrap: anywhere; }
.group-profile-form { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; text-align: left; }
.group-profile-form > label:not(.group-photo-picker), .group-add-member > label { color: #526174; font-size: 10px; font-weight: 600; }
.group-photo-picker { position: relative; width: fit-content; display: inline-flex; align-items: center; gap: 6px; padding: 7px 9px; border: 1px solid #dfe6f0; border-radius: 5px; color: #405d80; font-size: 10px; cursor: pointer; }
.group-photo-picker input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
.group-profile-form .primary-button { min-height: 36px; }
.group-add-member { display: flex; flex-direction: column; gap: 7px; margin-top: 16px; text-align: left; }
.group-add-member .search-field { margin: 0; }
.group-add-member .group-user-result { padding: 7px; }
.group-add-member .group-user-result .secondary-button { flex: 0 0 auto; }
.group-member-list { width: 100%; max-height: 235px; display: flex; flex-direction: column; gap: 3px; overflow: auto; margin-top: 16px; padding-top: 10px; border-top: 1px solid #edf0f4; text-align: left; }
.group-member-list h3 { margin: 0 0 4px; color: #526174; font-size: 11px; font-weight: 600; }
.group-member-list > div { display: flex; align-items: center; gap: 9px; padding: 5px 2px; }
.group-member-list .avatar { width: 34px; height: 34px; flex-basis: 34px; font-size: 11px; }
.group-member-list > div > span:nth-child(2) { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 3px; }
.group-member-list strong { overflow: hidden; color: #37465b; font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
.group-member-list small { color: #8996a8; font-size: 9px; }
.group-member-remove { width: 28px; height: 28px; display: grid; place-items: center; border: 0; border-radius: 4px; background: transparent; color: #b74a55; cursor: pointer; }
.group-member-remove:hover { background: #fff0f1; }
.group-leave-button { width: 100%; min-height: 36px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; margin-top: 14px; border: 1px solid #efd4d7; border-radius: 5px; background: #fff7f7; color: #ad3947; font-size: 10px; font-weight: 600; cursor: pointer; }
.group-leave-button:hover { background: #ffeded; }
.contact-block-button { width: 100%; min-height: 36px; margin-top: 11px; border: 1px solid #efd4d7; border-radius: 5px; background: #fff7f7; color: #ad3947; font-size: 10px; font-weight: 600; cursor: pointer; }
.contact-block-button:hover { background: #ffeded; }
.status-media-picker { position: relative; width: fit-content; display: inline-flex; align-items: center; gap: 6px; padding: 7px 9px; border: 1px solid #dfe6f0; border-radius: 5px; color: #405d80; font-size: 10px; cursor: pointer; }
.status-media-picker input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
.status-media-preview { position: relative; max-height: 220px; overflow: hidden; border: 1px solid #dce4ee; border-radius: 6px; background: #101820; }
.status-media-preview img, .status-media-preview video { display: block; width: 100%; max-height: 220px; object-fit: contain; }
.status-media-preview > button { position: absolute; top: 6px; right: 6px; background: rgba(0, 0, 0, .55); color: #fff; }
.status-viewer > main .status-media-viewer { display: block; max-width: 100%; max-height: 430px; margin: 0 auto; object-fit: contain; }
.status-viewer > main video.status-media-viewer { width: 100%; }
.forward-message-modal blockquote { margin: 0 0 12px; padding: 10px 12px; border-left: 3px solid #7e9fc8; border-radius: 3px; background: #f3f6fa; color: #58677b; font-size: 11px; }
.forward-destinations { max-height: min(360px, 50dvh); overflow-y: auto; }
.forward-destinations .result-user { border-bottom: 1px solid #edf0f4; }
.status-composer-form { display: flex; flex-direction: column; gap: 12px; }
.status-text-heading { display: flex; align-items: center; justify-content: space-between; }
.status-text-heading > label { color: #4f5c6d; font-size: 11px; font-weight: 600; }
.status-emoji-picker { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 4px; padding: 8px; border: 1px solid #dfe6f0; border-radius: 6px; background: #f8fafd; }
.status-emoji-picker button { min-width: 0; min-height: 36px; display: grid; place-items: center; border: 0; border-radius: 4px; background: transparent; font-size: 20px; cursor: pointer; }
.status-emoji-picker button:hover { background: #eaf2ff; }
.status-composer-form > textarea { width: 100%; min-height: 110px; resize: vertical; padding: 12px; border: 1px solid #dfe6f0; border-radius: 6px; color: #2d3a4e; font: 500 15px/1.5 'DM Sans', sans-serif; }
.status-composer-actions { display: flex; align-items: center; gap: 10px; }
.status-composer-actions > span { flex: 1; color: #8795a8; font-size: 9px; text-align: right; }
.status-composer-actions .primary-button { padding: 0 13px; }
.status-preview { position: relative; max-height: 270px; overflow: hidden; border-radius: 6px; background: #101827; text-align: center; }
.status-preview img, .status-preview video { max-width: 100%; max-height: 270px; }
.status-preview > button { position: absolute; top: 6px; right: 6px; background: rgba(0, 0, 0, .5); color: #fff; }
.status-viewer-scrim { background: rgba(7, 14, 29, .78); }
.status-viewer { width: min(440px, 100%); max-height: min(780px, calc(100dvh - 32px)); display: flex; flex-direction: column; overflow: hidden; border-radius: 9px; background: #111b2b; color: #eff4fc; box-shadow: 0 24px 90px rgba(0, 0, 0, .4); }
.status-viewer > header { display: flex; align-items: center; gap: 9px; padding: 11px 14px; }
.status-viewer > header .avatar { width: 34px; height: 34px; flex-basis: 34px; }
.status-viewer > header > span { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 3px; }
.status-viewer > header strong { overflow: hidden; font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
.status-viewer > header small { color: #a6b4c8; font-size: 9px; }
.status-progress { height: 3px; margin: 0 12px; overflow: hidden; border-radius: 2px; background: #334157; }
.status-progress i { height: 100%; display: block; background: #48bce0; transition: width .2s; }
.status-viewer > main { min-height: 200px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 15px; overflow: auto; padding: 20px; }
.status-viewer > main .message-attachment-image { max-width: 100%; max-height: 58dvh; border: 0; background: transparent; }
.status-viewer > main .message-attachment-image img { max-height: 58dvh; }
.status-viewer > main p { max-width: 100%; margin: 0; color: #f1f5fc; font-size: 15px; line-height: 1.55; text-align: center; white-space: pre-wrap; overflow-wrap: anywhere; }
.status-interactions { display: flex; flex-direction: column; gap: 9px; max-height: 230px; overflow: auto; padding: 0 13px 10px; }
.status-reaction-row { min-height: 34px; display: flex; align-items: center; gap: 15px; border-bottom: 1px solid #29374c; }
.status-like-button, .status-view-count { display: inline-flex; align-items: center; gap: 6px; border: 0; background: transparent; color: #b8c5d7; font-size: 10px; }
.status-like-button { padding: 5px 2px; cursor: pointer; }
.status-like-button.is-liked { color: #ff7187; }
.status-like-button:disabled { cursor: default; }
.status-view-count { margin-left: auto; }
.status-viewer-list, .status-comments { display: flex; flex-direction: column; gap: 7px; }
.status-viewer-list > strong, .status-comments > strong { color: #91a2b8; font-size: 9px; }
.status-viewer-list > span { display: flex; align-items: center; gap: 7px; color: #dce5f2; font-size: 10px; }
.status-viewer-list .avatar, .status-comment .avatar { width: 24px; height: 24px; flex-basis: 24px; font-size: 9px; }
.status-comment { display: flex; align-items: flex-start; gap: 7px; }
.status-comment-avatar { width: 24px; height: 24px; flex: 0 0 24px; padding: 0; border: 0; border-radius: 50%; background: transparent; cursor: pointer; }
.status-comment-avatar:focus-visible { outline: 2px solid #65b4e4; outline-offset: 2px; }
.status-comment > span { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 2px; color: #dce5f2; font-size: 10px; line-height: 1.4; overflow-wrap: anywhere; }
.status-comment > span > b { color: #8fa6c2; font-size: 9px; }
.status-comment-delete { display: grid; flex: 0 0 24px; place-items: center; width: 24px; height: 24px; border: 0; background: transparent; color: #9aaac0; cursor: pointer; }
.status-comment-form { display: flex; align-items: center; gap: 6px; padding: 4px 5px 4px 10px; border: 1px solid #35445a; border-radius: 5px; background: #172337; }
.status-comment-form input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: #eff4fc; font: inherit; font-size: 10px; }
.status-comment-form input::placeholder { color: #8291a5; }
.status-comment-form button { display: grid; place-items: center; width: 29px; height: 29px; border: 0; border-radius: 4px; background: #0877f4; color: white; cursor: pointer; }
.status-comment-form button:disabled { opacity: .45; cursor: default; }
.status-viewer > footer { display: flex; align-items: center; gap: 8px; padding: 11px; border-top: 1px solid #29374c; }
.status-viewer > footer span { flex: 1; color: #a8b6c9; text-align: center; font-size: 9px; }
.status-viewer > footer button { min-height: 30px; padding: 0 9px; border: 1px solid #35445a; border-radius: 4px; background: #1b2940; color: #dbe6f5; font-size: 9px; cursor: pointer; }
.status-viewer > footer .status-delete { border-color: #74454c; color: #ffb4b6; }
.activity-button { position: relative; }
.activity-button > i { position: absolute; top: 1px; right: 0; min-width: 15px; height: 15px; display: grid; place-items: center; padding: 0 3px; border: 1px solid #fff; border-radius: 9px; background: #d45159; color: #fff; font-size: 8px; font-style: normal; font-weight: 700; }
.status-activity-modal { width: min(440px, 100%); max-height: min(680px, calc(100dvh - 28px)); display: flex; flex-direction: column; }
.status-activity-modal .modal-heading { flex: 0 0 auto; }
.status-activity-list { display: flex; flex-direction: column; overflow-y: auto; margin: 0 -20px -20px; padding: 0 20px 20px; }
.status-activity-item { position: relative; min-height: 68px; display: flex; align-items: center; gap: 11px; padding: 10px 8px; border: 0; border-bottom: 1px solid #edf0ed; background: transparent; text-align: left; cursor: pointer; }
.status-activity-item:hover { background: #f4f8f5; }
.status-activity-item.is-unread::before { position: absolute; left: 0; width: 5px; height: 5px; border-radius: 50%; background: #138b70; content: ''; }
.status-activity-item .avatar { width: 36px; height: 36px; flex-basis: 36px; }
.status-activity-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 3px; color: #56635c; font-size: 11px; line-height: 1.4; }
.status-activity-copy strong { color: #263b32; }
.status-activity-copy small { overflow: hidden; color: #79867f; text-overflow: ellipsis; white-space: nowrap; }
.status-activity-copy time { color: #98a19b; font-size: 9px; }
.status-activity-kind { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: #edf4ef; color: #3e7960; }
.status-activity-like { background: #fff0f1; color: #d45167; }
.status-activity-comment { background: #edf2fa; color: #5876a6; }
.status-activity-empty { min-height: 190px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px; color: #829087; text-align: center; }
.status-activity-empty strong { color: #33473c; font-size: 14px; }
.status-activity-empty span { font-size: 11px; }
.messenger-shell[data-theme="dark"] .inbox-tabs { border-color: #2a3b53; background: #111c2b; }
.messenger-shell[data-theme="dark"] .inbox-tabs button { color: #a7b8ce; }
.messenger-shell[data-theme="dark"] .inbox-tabs button.inbox-tab-active { background: #21344e; color: #c9deff; }
.messenger-shell[data-theme="dark"] .inbox-tabs button span { color: #9aacc3; }
.messenger-shell[data-theme="dark"] .status-list-item strong,
.messenger-shell[data-theme="dark"] .group-member-list strong,
.messenger-shell[data-theme="dark"] .group-user-result strong { color: #e2eaf5; }
.messenger-shell[data-theme="dark"] .status-list-item small,
.messenger-shell[data-theme="dark"] .group-member-list small,
.messenger-shell[data-theme="dark"] .group-search-hint { color: #9cadc2; }
.messenger-shell[data-theme="dark"] .status-list-item:hover,
.messenger-shell[data-theme="dark"] .group-user-result:hover,
.messenger-shell[data-theme="dark"] .group-user-result.is-selected { background: #1b304a; }
.messenger-shell[data-theme="dark"] .status-ring.status-unviewed::before { border-color: #141f2e; }
.messenger-shell[data-theme="dark"] .status-add-ring > i { border-color: #141f2e; }
.messenger-shell[data-theme="dark"] .status-add-control { border-color: #35475f; color: #9fc8ff; }
.messenger-shell[data-theme="dark"] .group-avatar { background: #203a5d; color: #a4caff; }
.messenger-shell[data-theme="dark"] .group-selected > button { border-color: #354c6d; background: #1d3048; color: #b7d3f8; }
.messenger-shell[data-theme="dark"] .group-user-results,
.messenger-shell[data-theme="dark"] .group-user-result,
.messenger-shell[data-theme="dark"] .group-member-list,
.messenger-shell[data-theme="dark"] .status-viewer > footer { border-color: #2b3b51; }
.messenger-shell[data-theme="dark"] .group-search-hint,
.messenger-shell[data-theme="dark"] .group-selected > strong { color: #9aabc0; }
.messenger-shell[data-theme="dark"] .group-details-profile p,
.messenger-shell[data-theme="dark"] .group-profile-form > label:not(.group-photo-picker),
.messenger-shell[data-theme="dark"] .group-add-member > label,
.messenger-shell[data-theme="dark"] .group-member-list h3 { color: #a9b8cc; }
.messenger-shell[data-theme="dark"] .group-photo-picker { border-color: #35475f; color: #bfd2ec; }
.messenger-shell[data-theme="dark"] .group-member-remove:hover { background: #402b34; }
.messenger-shell[data-theme="dark"] .group-leave-button { border-color: #63404a; background: #35242b; color: #ff9aa5; }
.messenger-shell[data-theme="dark"] .group-leave-button:hover { background: #452932; }
.messenger-shell[data-theme="dark"] .message-action-trigger { border-color: #394b63; background: #1d2b3d; color: #bdcbe0; }
.messenger-shell[data-theme="dark"] .message-action-menu { border-color: #354a3a; background: rgba(25, 39, 30, .98); }
.messenger-shell[data-theme="dark"] .message-reaction-picker { border-color: #344b38; background: #202f24; }
.messenger-shell[data-theme="dark"] .message-action-options > button { color: #d8e8da; }
.messenger-shell[data-theme="dark"] .message-action-options > button:hover,
.messenger-shell[data-theme="dark"] .message-reaction-picker button:hover { background: #2d4632; }
.messenger-shell[data-theme="dark"] .message-reaction { border-color: #394c65; background: #1a283a; }
.messenger-shell[data-theme="dark"] .message-reaction.is-mine { border-color: #5577a3; background: #20334d; }
.messenger-shell[data-theme="dark"] .message-reaction small,
.messenger-shell[data-theme="dark"] .message-composer-context small { color: #a3b2c7; }
.messenger-shell[data-theme="dark"] .message-composer-context { border-color: #31435c; background: #172437; }
.messenger-shell[data-theme="dark"] .message-composer-context strong { color: #d6e0ee; }
.messenger-shell[data-theme="dark"] .chat-message-restriction { background: #35242b; color: #ff9aa5; }
.messenger-shell[data-theme="dark"] .contact-block-button { border-color: #63404a; background: #35242b; color: #ff9aa5; }
.messenger-shell[data-theme="dark"] .status-media-picker { border-color: #35475f; color: #bfd2ec; }
.messenger-shell[data-theme="dark"] .forward-message-modal blockquote { border-color: #57769f; background: #19273a; color: #b7c7dd; }

@media (pointer: coarse) {
  .message-action-trigger { opacity: 1; }
}

@media (max-width: 420px) {
  .message-action-menu { width: min(276px, calc(100vw - 20px)); padding: 6px; border-radius: 15px; }
  .message-reaction-picker { gap: 1px; padding: 3px; }
  .message-reaction-picker button { height: 38px; font-size: 21px; }
  .message-action-options > button { min-height: 40px; padding-inline: 9px; font-size: 11px; }
}

@media (max-width: 760px) {
  .inbox-title-row { padding: 16px 15px 12px; }
  .inbox-tabs { margin: 0 12px 10px; }
  .sidebar-header { padding-right: 13px; padding-left: 13px; }
  .header-actions { gap: 1px; }
  .header-actions .icon-button { width: 32px; height: 34px; }
  .status-viewer { width: 100%; max-height: calc(100dvh - 24px); border-radius: 10px 10px 0 0; }
  .status-composer-actions { flex-wrap: wrap; }
  .status-composer-actions .photo-pick-button { flex: 0 0 auto; }
  .status-composer-actions > span { min-width: 48px; }
  .group-create-modal { min-height: 0; max-height: calc(100dvh - 10px); overflow-y: auto; }
}

@media (max-width: 760px) {
  .messenger-shell { height: 100dvh; min-height: 0; }
  .chat-header { padding-right: 12px; }
  .chat-own-account { width: 36px; height: 36px; flex: 0 0 36px; justify-content: center; padding: 2px; }
  .chat-own-account > span { display: none; }
  .contact-profile-trigger { gap: 8px; }
  .composer { gap: 5px; padding-left: 7px; }
  .composer-tool { width: 30px; flex-basis: 30px; }
  .composer input { font-size: 11px; }
  .message-stage { padding-right: 12px; padding-left: 12px; }
  .contact-profile-modal { align-self: center; width: calc(100% - 28px); }
  .attachment-draft { margin-right: 10px; margin-left: 10px; }
}
.signout-confirm { display: flex; flex-direction: column; gap: 7px; margin-top: 9px; padding: 13px; border: 1px solid #efd9dc; border-radius: 6px; background: #fff8f8; }
.signout-confirm strong { color: #553a40; font-size: 12px; }
.signout-confirm > span { color: #896e74; font-size: 10px; line-height: 1.5; }
.signout-confirm > div { display: flex; justify-content: flex-end; gap: 7px; margin-top: 4px; }
.cancel-button, .confirm-signout-button { min-height: 32px; padding: 0 11px; border-radius: 4px; font-size: 10px; font-weight: 600; cursor: pointer; }
.cancel-button { border: 1px solid #dfe6ef; background: #fff; color: #536278; }
.confirm-signout-button { border: 1px solid #ac494f; background: #b84a52; color: #fff; }
.confirm-signout-button:hover { background: #9f3941; }
.auth-page { height: 100dvh; min-height: 100dvh; overflow-y: auto; overscroll-behavior-y: contain; }
.auth-content { min-height: 0; }
.auth-choice-screen { display: flex; flex-direction: column; align-items: stretch; gap: 12px; }
.auth-choice-screen .form-icon { margin-bottom: 4px; }
.auth-choice-screen h2 { margin: 0; color: #253750; font: 700 20px 'Manrope', sans-serif; }
.auth-choice-screen > p { margin: 0 0 6px; color: #7d8999; font-size: 12px; }
.auth-choice-screen .primary-button, .auth-choice-screen .secondary-button { width: 100%; justify-content: space-between; padding: 0 14px; }
.auth-choice-screen .primary-button > span, .auth-choice-screen .secondary-button > span { font-size: 17px; }
.secondary-button { min-height: 43px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 0 14px; border: 1px solid #dfe7f1; border-radius: 5px; background: #fff; color: #426084; font-size: 12px; font-weight: 600; cursor: pointer; }
.secondary-button:hover { border-color: #aac7ee; background: #f5f8fd; }
.auth-form-heading { display: flex; gap: 13px; align-items: center; padding-bottom: 18px; border-bottom: 1px solid #eff1ed; }
.register-progress { display: grid; grid-template-columns: auto minmax(50px, 1fr) auto; align-items: center; gap: 10px; margin-bottom: 2px; }
.register-progress > span { color: #71829a; font-size: 9px; font-weight: 700; white-space: nowrap; }
.register-progress > div { height: 4px; overflow: hidden; border-radius: 4px; background: #e8edf4; }
.register-progress > div > i { height: 100%; display: block; border-radius: inherit; background: linear-gradient(90deg, #1769df, #29b9d7); transition: width .2s ease; }
.register-progress > button { padding: 4px; border: 0; background: none; color: #77869b; font-size: 10px; cursor: pointer; }
.register-step-form { gap: 10px; }
.register-step-actions { display: flex; gap: 9px; margin-top: 5px; }
.register-step-actions .auth-submit { flex: 1; margin-top: 0; }
.register-step-actions .secondary-button { min-width: 76px; }
.auth-mode-switch { margin: 16px 0 0; color: #838a83; text-align: center; font-size: 11px; }
.auth-mode-switch button { padding: 0; border: 0; background: none; color: #1269e8; font-size: inherit; font-weight: 700; cursor: pointer; }
.code-prefix { color: #607998; font-size: 14px; font-weight: 700; }
.account-policies { max-height: 150px; overflow-y: auto; padding: 11px 12px; border: 1px solid #e5ebf3; border-radius: 5px; background: #f8fafd; }
.account-policies > strong { color: #40536e; font-size: 10px; }
.account-policies ul { display: flex; flex-direction: column; gap: 7px; margin: 8px 0 0; padding-left: 16px; color: #738197; font-size: 9px; line-height: 1.45; }
.policy-consent { display: flex; align-items: flex-start; gap: 8px; margin-top: 2px !important; color: #596b82 !important; font-size: 10px !important; line-height: 1.45; }
.policy-consent input { width: 15px; height: 15px; flex: 0 0 15px; margin: 0; accent-color: #1269e8; }
.messenger-shell[data-theme="dark"] .auth-choice-screen h2 { color: #e5edf8; }
.messenger-shell[data-theme="dark"] .account-policies { border-color: #30425b; background: #101b2a; }
.messenger-shell[data-theme="dark"] .account-policies > strong,
.messenger-shell[data-theme="dark"] .policy-consent { color: #c1cde0 !important; }
.messenger-shell[data-theme="dark"] .account-policies ul { color: #9cadc2; }
.messenger-shell[data-theme="dark"] .status-text-heading > label { color: #bdcadd; }
.messenger-shell[data-theme="dark"] .status-emoji-picker { border-color: #30425b; background: #101b2a; }
.messenger-shell[data-theme="dark"] .status-emoji-picker button:hover { background: #213550; }
@media (max-width: 760px) {
  .auth-page { padding-right: 16px; padding-bottom: max(14px, env(safe-area-inset-bottom)); padding-left: 16px; }
  .auth-content { width: 100%; display: flex; flex-direction: column; align-items: stretch; gap: 20px; padding: 28px 0 24px; }
  .auth-copy { max-width: none; }
  .auth-copy h1 { margin: 13px 0 8px; font-size: 32px; }
  .auth-copy > p { max-width: 440px; font-size: 12px; }
  .auth-footnote { margin-top: 12px; font-size: 9px; }
  .auth-form-wrap { max-width: 480px; margin: 0 auto; padding: 20px 18px 17px; }
  .auth-topline { flex: 0 0 65px; }
  .auth-footer { flex: 0 0 45px; }
  .auth-mode-switch { margin-top: 12px; }
}
.messenger-shell[data-theme="dark"] .secondary-button { border-color: #344862; background: #1b2a40; color: #c5d5e9; }
.messenger-shell[data-theme="dark"] .secondary-button:hover { background: #213550; }
.developer-badge {
  color: #2196F3;
  margin-left: 4px;
  vertical-align: middle;
  filter: drop-shadow(0 0 3px rgba(33, 150, 243, 0.6));

}



.message-stage {
  position: relative;
}

.wallpaper-opacity-control {
  margin-top: 16px;
  padding: 12px;
  background: #f5f7fa;
  border-radius: 8px;
}
.wallpaper-opacity-control label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: #4a5568;
  margin-bottom: 8px;
}
.wallpaper-opacity-control input[type="range"] {
  width: 100%;
  accent-color: #2196F3;
}

/* Saare messages, text, aur UI elements background ke upar */

/* Header aur input bar ko koi farq na pade */
.chat-header,
.composer,
.chat-privacy,
.message-date,
.first-message {
  position: relative;
  z-index: 2;
}

.message-stage.has-custom-wallpaper {
  position: relative;
  background: transparent !important;
}

.message-stage.has-custom-wallpaper::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: var(--chat-wallpaper-image);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  opacity: var(--wallpaper-opacity, 0.3);
  pointer-events: none;
  z-index: 0;
}

.message-stage.has-custom-wallpaper > * {
  position: relative;
  z-index: 1;
}

/* Composer tools */
.composer-tool {
  background: transparent;
  border: none;
  color: #5a6a7e;
  cursor: pointer;
  padding: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background 0.15s ease, color 0.15s ease;
}
.composer-tool:hover {
  background: #eef2f8;
  color: #2196F3;
}
.voice-record-button {
  background: #25d366;
  border: none;
  color: #fff;
  cursor: pointer;
  padding: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  width: 36px;
  height: 36px;
  transition: transform 0.15s ease, background 0.15s ease;
}
.voice-record-button:active {
  transform: scale(0.92);
  background: #1db954;
}
.composer-emoji-picker {
  position: absolute;
  bottom: 70px;
  left: 12px;
  right: 12px;
  background: #fff;
  border: 1px solid #e0e6ef;
  border-radius: 12px;
  padding: 8px;
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 4px;
  box-shadow: 0 8px 24px rgba(25, 42, 64, 0.16);
  z-index: 10;
}
.composer-emoji-picker button {
  background: transparent;
  border: none;
  font-size: 22px;
  cursor: pointer;
  padding: 4px;
  border-radius: 6px;
  transition: background 0.12s ease;
}
.composer-emoji-picker button:hover {
  background: #eef2f8;
}
.attachment-draft {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  background: #f3f6fa;
  border-top: 1px solid #e0e6ef;
  color: #2c3e50;
  font-size: 13px;
}
.attachment-draft strong {
  display: block;
  font-size: 13px;
}
.attachment-draft small {
  color: #7a8a9e;
  font-size: 11px;
}

/* FarazChat premium visual system */
:root {
  --premium-ink: #17231e;
  --premium-muted: #78847c;
  --premium-line: #e1e8e2;
  --premium-canvas: #f2f5f1;
  --premium-surface: #ffffff;
  --premium-forest: #143a2d;
  --premium-jade: #18805e;
  --premium-jade-deep: #106146;
  --premium-citrus: #d7ed8c;
  --premium-citrus-soft: #eff6d9;
  --premium-coral: #d66b61;
}

body { background: var(--premium-canvas); color: var(--premium-ink); }
button, input, textarea { font-family: inherit; }
button:focus-visible, input:focus-visible, textarea:focus-visible { outline: 3px solid rgba(24, 128, 94, .35); outline-offset: 2px; }

.auth-page {
  color: #edf4ee;
  background:
    radial-gradient(ellipse at 12% 88%, rgba(98, 163, 115, .2), transparent 32%),
    radial-gradient(ellipse at 84% 12%, rgba(215, 237, 140, .12), transparent 29%),
    #101d17;
}
.auth-topline { border-color: rgba(225, 239, 226, .12); }
.auth-page .brand { color: #f2f7f0; }
.auth-page .brand-light { color: #a9b8ab; }
.private-note { color: #a6b5a8; }
.auth-page .eyebrow { color: #c8df9a; }
.auth-copy h1 { color: #f1f6ef; }
.auth-copy h1 span { color: var(--premium-citrus); }
.auth-copy > p { color: #a7b5aa; }
.auth-footnote { color: #cad5cb; }
.auth-footnote svg { color: var(--premium-citrus); }
.auth-form-wrap { border-color: rgba(255, 255, 255, .12); border-radius: 18px; background: rgba(246, 249, 244, .97); box-shadow: 0 28px 90px rgba(0, 0, 0, .3); }
.auth-form-wrap h2, .auth-choice-screen h2 { color: var(--premium-ink); }
.auth-form-wrap p, .auth-form-wrap label { color: #69786e; }
.auth-form-wrap .form-icon { border-radius: 12px; background: var(--premium-citrus-soft); color: var(--premium-forest); }
.auth-form-wrap .field-with-icon { border-radius: 11px; }
.auth-form-wrap .primary-button { border-radius: 11px; background: var(--premium-forest); }
.auth-form-wrap .primary-button:hover { background: var(--premium-jade-deep); }
.auth-form-wrap .secondary-button { border-radius: 11px; }
.auth-form-wrap .auth-mode-switch button,
.auth-form-wrap .auth-back-button { color: var(--premium-jade); }
.auth-footer { border-color: rgba(225, 239, 226, .12); color: #829187; }
.auth-footer span:first-child { color: var(--premium-citrus); }

.messenger-shell {
  background: var(--premium-canvas);
  color: var(--premium-ink);
  font-family: 'DM Sans', sans-serif;
}
.sidebar { border-right-color: #dce5dd; background: #fbfcfa; }
.sidebar-header { height: 76px; padding-inline: 22px; border-bottom-color: #e7ece7; }
.app-brand { color: var(--premium-forest); font-size: 18px; }
.app-brand .brand-light { color: #8a978e; }
.header-actions .icon-button { border-radius: 10px; color: #6d7c72; }
.header-actions .icon-button:hover { background: #eaf2e9; color: var(--premium-jade-deep); }
.connection-indicator.is-online { background: #2a9c69; box-shadow: 0 0 0 4px #e2f2e4; }
.inbox-title-row { padding: 28px 22px 17px; }
.inbox-kicker, .modal-kicker { color: #87968b; }
.inbox-title-row h1 { color: var(--premium-ink); font-size: 24px; }
.text-new-chat { color: var(--premium-jade-deep); }
.inbox-tabs { margin-inline: 16px; border-color: #e1e8e0; border-radius: 12px; background: #eef2ec; }
.inbox-tabs button { min-height: 35px; border-radius: 9px; color: #748177; }
.inbox-tabs button.inbox-tab-active { background: #fff; color: var(--premium-forest); box-shadow: 0 2px 8px rgba(21, 51, 35, .09); }
.search-field { border-radius: 11px; background: #f0f3ef; }
.conversation-search { margin-inline: 17px; }
.conversation-search:focus-within { border-color: rgba(24, 128, 94, .52); background: #fff; box-shadow: 0 0 0 3px rgba(24, 128, 94, .08); }
.conversation-item { min-height: 74px; border-radius: 12px; }
.conversation-item:hover { background: #f0f5ef; }
.conversation-item.conversation-active { background: #e9f1e5; box-shadow: inset 3px 0 var(--premium-jade); }
.conversation-top strong { color: #25352b; font-size: 12px; }
.conversation-top time, .conversation-bottom > span { color: #89958c; }
.profile-footer { min-height: 76px; border-top-color: #e5ebe5; background: #f7f9f6; }
.profile-footer .avatar { border-color: #dce7dc; background: #e8f0e4; color: var(--premium-forest); }
.profile-name strong { color: #2a3b30; }

.chat-panel {
  background-color: #edf2ec;
  background-image: radial-gradient(rgba(74, 111, 81, .075) .7px, transparent .7px);
  background-size: 23px 23px;
}
.chat-header { height: 76px; flex-basis: 76px; padding-inline: 30px; border-bottom-color: #dfe7df; background: rgba(250, 252, 249, .94); backdrop-filter: blur(16px); }
.contact-profile-trigger:hover .chat-contact strong { color: var(--premium-jade-deep); }
.chat-contact strong { color: #27382d; font-size: 13px; }
.chat-contact span { color: #849187; }
.message-stage { gap: 9px; padding-top: 25px; }
.message-date span { border-color: rgba(215, 226, 215, .9); border-radius: 20px; background: rgba(249, 251, 247, .86); color: #859187; letter-spacing: .5px; }
.first-message .avatar-large { border: 3px solid rgba(255, 255, 255, .8); box-shadow: 0 8px 26px rgba(39, 72, 47, .13); }
.message-stack { gap: 5px; }
.message-bubble { padding: 11px 15px; border: 1px solid #e1e9e1; border-left: 2px solid #95b69a; border-radius: 5px 17px 17px 17px; background: #fff; box-shadow: 0 4px 13px rgba(27, 52, 34, .06); color: #27332b; }
.message-mine .message-bubble { border-color: #d7e8cf; border-right: 2px solid #8dbb83; border-radius: 17px 5px 17px 17px; background: #e5f2dc; color: #233b2c; }
.message-reactions { gap: 5px; margin-top: 1px; }
.message-reaction { padding: 4px 8px; border-color: #dce7dd; border-radius: 14px; background: rgba(255, 255, 255, .95); box-shadow: 0 2px 5px rgba(27, 52, 34, .05); }
.message-reaction.is-mine { border-color: #8ebf97; background: #e6f3e4; }
.message-action-trigger { width: 29px; height: 29px; border-color: #dce6dd; border-radius: 50%; color: #617468; box-shadow: 0 3px 9px rgba(29, 51, 33, .09); }
.message-time { color: #89958b; }
.message-read-receipt.is-read, .message-read-receipt.is-read svg { color: #1c89c0; stroke: #1c89c0; }
.composer { min-height: 58px; margin-inline: clamp(14px, 5vw, 70px); padding: 7px 9px 7px 15px; border-color: #dbe5db; border-radius: 17px; background: rgba(255, 255, 255, .97); box-shadow: 0 8px 24px rgba(31, 57, 38, .08); }
.composer:focus-within { border-color: #83b59a; box-shadow: 0 0 0 4px rgba(24, 128, 94, .08), 0 8px 24px rgba(31, 57, 38, .08); }
.composer-tool { border-radius: 9px; color: #78867c; }
.composer-tool:hover { background: #eff5ed; color: var(--premium-jade-deep); }
.composer input { color: #2b3a2f; font-size: 13px; }
.send-button, .voice-record-button { width: 40px; height: 40px; flex-basis: 40px; border-radius: 13px; background: var(--premium-forest); transition: background .15s ease, transform .15s ease; }
.send-button:hover, .voice-record-button:active { background: var(--premium-jade); }
.voice-record-button { background: #d9edaa; color: #274b31; }
.voice-record-button:active { color: #fff; }
.voice-send-button { background: var(--premium-jade); color: #fff; }
.chat-privacy { height: 34px; color: #87938a; }
.chat-error { border-top: 1px solid #f0d8d4; background: #fff7f5; }

.voice-note-player { border-color: #d6e6d4; border-radius: 18px 18px 18px 6px; background: linear-gradient(135deg, #f9fff3, #e8f4de); box-shadow: 0 7px 20px rgba(35, 74, 46, .1); }
.message-mine .voice-note-player { border-color: #c4e4c4; border-radius: 18px 18px 6px 18px; background: linear-gradient(135deg, #e5f6dc, #d3edca); }
.voice-play-button { background: var(--premium-forest); box-shadow: 0 4px 10px rgba(20, 58, 45, .23); }
.voice-play-button:hover { background: var(--premium-jade); }
.voice-waveform i.is-played, .message-mine .voice-waveform i.is-played { background: var(--premium-jade); }
.voice-note-heading { color: #506e59; letter-spacing: .9px; }
.voice-note-meta > button { border-radius: 11px; background: rgba(255, 255, 255, .8); }

.modal-scrim { background: rgba(12, 29, 21, .42); backdrop-filter: blur(7px); }
.new-chat-modal, .contact-profile-modal { border-color: #e0e8df; border-radius: 18px; box-shadow: 0 28px 90px rgba(18, 42, 27, .24); }
.modal-heading h2, .contact-profile-modal h2 { color: #1d3025; }
.modal-search { border-radius: 12px; background: #f0f4ef; }
.result-user { border-radius: 10px; }
.primary-button { border-radius: 11px; background: var(--premium-forest); }
.primary-button:hover { background: var(--premium-jade-deep); }
.secondary-button { border-radius: 11px; }
.settings-modal { border-color: #dfe7df; border-radius: 18px; box-shadow: 0 28px 90px rgba(18, 42, 27, .24); }
.settings-header { background: linear-gradient(100deg, #f0f5e9, #fff 72%); }
.settings-header h2 { color: #1b3125; }
.settings-nav { background: #f6f8f4; }
.settings-nav-active, .settings-nav-active:hover { background: #e5efdf; color: var(--premium-jade-deep); }
.settings-row, .account-identity { border-radius: 12px; background: #fbfcfa; }
.setting-icon { border-radius: 10px; background: #edf4e7; color: var(--premium-jade-deep); }
.wallpaper-choice { border-radius: 10px; }
.wallpaper-choice.is-selected { border-color: var(--premium-jade); box-shadow: 0 0 0 3px rgba(24, 128, 94, .11); }
.wallpaper-opacity-control { border: 1px solid #e3eae2; border-radius: 12px; background: #f7f9f5; }
.wallpaper-opacity-control input[type="range"] { accent-color: var(--premium-jade); }
.status-list-item { border-radius: 12px; }
.status-list-item:hover { background: #f0f5ef; }
.status-add-ring > i { background: var(--premium-jade); }
.status-unviewed { filter: saturate(.9); }

.messenger-shell[data-theme="dark"] { background: #101b15; color: #e7efe8; }
.messenger-shell[data-theme="dark"] .sidebar,
.messenger-shell[data-theme="dark"] .sidebar-header,
.messenger-shell[data-theme="dark"] .profile-footer,
.messenger-shell[data-theme="dark"] .chat-header { border-color: #2b3c30; background: #17231b; }
.messenger-shell[data-theme="dark"] .chat-panel { background-color: #111b15; background-image: radial-gradient(rgba(153, 190, 148, .08) .7px, transparent .7px); }
.messenger-shell[data-theme="dark"] .conversation-item:hover { background: #1b2b20; }
.messenger-shell[data-theme="dark"] .conversation-item.conversation-active { background: #203628; box-shadow: inset 3px 0 #79b78a; }
.messenger-shell[data-theme="dark"] .search-field { border-color: #304336; background: #1c2b20; }
.messenger-shell[data-theme="dark"] .message-date span { border-color: #304235; background: rgba(26, 41, 30, .92); color: #a8b8aa; }
.messenger-shell[data-theme="dark"] .message-bubble { border-color: #344539; background: #1a291f; color: #e6eee7; }
.messenger-shell[data-theme="dark"] .message-mine .message-bubble { border-color: #426248; background: #263d2b; color: #e7f2e5; }
.messenger-shell[data-theme="dark"] .message-reaction { border-color: #394b3d; background: #1a291f; }
.messenger-shell[data-theme="dark"] .message-reaction.is-mine { border-color: #648869; background: #2b4630; }
.messenger-shell[data-theme="dark"] .composer { border-color: #334638; background: #1a291f; box-shadow: 0 8px 24px rgba(0, 0, 0, .2); }
.messenger-shell[data-theme="dark"] .composer input { color: #e6eee7; }
.messenger-shell[data-theme="dark"] .composer-tool { color: #a1b1a3; }
.messenger-shell[data-theme="dark"] .composer-tool:hover { background: #293d2d; color: #d8edb0; }
.messenger-shell[data-theme="dark"] .send-button { background: #245b40; }
.messenger-shell[data-theme="dark"] .voice-record-button { background: #d9edaa; color: #274b31; }
.messenger-shell[data-theme="dark"] .voice-note-player { border-color: #3b5740; background: linear-gradient(135deg, #263a29, #1e3023); }
.messenger-shell[data-theme="dark"] .message-mine .voice-note-player { border-color: #4a704b; background: linear-gradient(135deg, #2d4a31, #233d2b); }
.messenger-shell[data-theme="dark"] .voice-note-heading,
.messenger-shell[data-theme="dark"] .voice-note-meta { color: #c1d3c3; }
.messenger-shell[data-theme="dark"] .voice-waveform i { background: #7d997e; }
.messenger-shell[data-theme="dark"] .voice-waveform i.is-played { background: #77c394; }

@media (max-width: 760px) {
  .sidebar-header { height: 68px; }
  .inbox-title-row { padding: 20px 17px 14px; }
  .chat-header { height: 64px; flex-basis: 64px; background: rgba(250, 252, 249, .97); }
  .message-stage { padding: 16px 12px 12px; }
  .message-stack { max-width: 86%; }
  .composer { margin-inline: 9px; margin-bottom: max(4px, env(safe-area-inset-bottom)); }
  .chat-privacy { height: 27px; }
  .auth-form-wrap { border-radius: 17px; }
  .settings-modal { border-radius: 17px 17px 0 0; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}

/* Voice note recording and playback */
.voice-recording-indicator {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 50px;
  margin: 8px clamp(14px, 5vw, 63px);
  padding: 7px 12px;
  border: 1px solid #e0e0e0;
  border-radius: 24px;
  background: #fff;
  color: #333;
  font-size: 13px;
  font-weight: 500;
  box-shadow: 0 2px 8px rgba(0, 0, 0, .08);
  animation: voice-slide-up .2s ease-out;
  touch-action: pan-y;
  user-select: none;
}
.voice-cancel-button { width: 30px; height: 30px; flex: 0 0 30px; display: grid; place-items: center; padding: 0; border: 0; border-radius: 50%; background: transparent; color: #69716d; cursor: pointer; }
.voice-cancel-button:hover { background: #f1f3f2; color: #c62828; }
.recording-dot { width: 9px; height: 9px; flex: 0 0 9px; border-radius: 50%; background: #e53935; animation: pulse-recording 1s ease-in-out infinite; }
.voice-recording-indicator .recording-timer { flex: 0 0 auto; color: #414945; font-variant-numeric: tabular-nums; }
.recording-waveform { width: auto; min-width: 48px; height: 24px; flex: 1; display: flex; align-items: center; gap: 2px; overflow: hidden; }
.recording-waveform i { width: 2px; min-height: 4px; flex: 1 0 2px; border-radius: 1px; background: #e53935; }
.recording-hint { flex: 0 0 auto; color: #777; font-size: 12px; font-weight: 400; white-space: nowrap; }
.voice-recording-indicator.voice-cancel-pending { border-color: #efb7b7; background: #fff7f7; }
.voice-recording-indicator.voice-cancel-pending .recording-hint { color: #c62828; }
.voice-recording-indicator.voice-cancel-pending .recording-waveform i { background: #a5abb2; }
.voice-record-button { touch-action: manipulation; }
.voice-send-button { background: #25d366; color: #fff; }
.voice-send-button:hover { background: #1db954; }
.voice-send-button:disabled { background: #a8d9b8; color: #fff; }
@keyframes pulse-recording { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .5; transform: scale(.85); } }
@keyframes voice-slide-up { from { transform: translateY(16px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

.voice-note-player {
  width: min(332px, 100%);
  min-width: 232px;
  min-height: 76px;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 11px 14px;
  border: 1px solid #e2e9e3;
  border-radius: 15px 15px 15px 5px;
  background: linear-gradient(145deg, #fbfdf9, #f1f6f0);
  box-shadow: 0 3px 12px rgba(42, 76, 53, .07);
  animation: voice-bubble-in .2s ease-out;
}
.voice-note-player audio { display: none; }
.message-mine .voice-note-player { border-color: #c7e7d0; border-radius: 15px 15px 5px 15px; background: linear-gradient(145deg, #e7f9e7, #d5f2d8); }
.voice-play-button { position: relative; width: 40px; height: 40px; flex: 0 0 40px; display: grid; place-items: center; padding: 0 0 0 2px; border: 0; border-radius: 50%; background: #20945c; color: #fff; cursor: pointer; box-shadow: 0 3px 8px rgba(24, 128, 77, .22); transition: transform .16s ease, background .16s ease; }
.voice-play-button:hover { transform: scale(1.05); background: #177f4d; }
.voice-note-player.is-playing .voice-play-button::after { position: absolute; inset: -4px; border: 1px solid rgba(32, 148, 92, .42); border-radius: inherit; content: ''; animation: voice-play-pulse 1.8s ease-out infinite; }
.voice-note-track { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 3px; }
.voice-note-heading { display: flex; align-items: center; gap: 6px; color: #527160; font-size: 8px; font-weight: 800; line-height: 1; }
.voice-note-heading > span { letter-spacing: .7px; }
.voice-note-heading > i { width: 5px; height: 5px; border-radius: 50%; background: #9cb6a3; }
.voice-note-heading > i.is-active { background: #20945c; box-shadow: 0 0 0 3px rgba(32, 148, 92, .12); }
.voice-waveform { width: 100%; height: 25px; display: flex; align-items: center; gap: 2px; padding: 0; border: 0; background: transparent; cursor: pointer; }
.voice-waveform i { min-width: 2px; flex: 1; border-radius: 2px; background: #a5b7aa; transition: background .16s ease, height .12s ease, opacity .16s ease; }
.voice-waveform i.is-played { background: #21945c; }
.voice-note-meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 16px; color: #617068; font-size: 10px; line-height: 1; font-variant-numeric: tabular-nums; }
.voice-note-meta > span i { margin: 0 3px; color: #9aa89f; font-style: normal; }
.voice-note-meta > button { min-width: 31px; padding: 3px 5px; border: 1px solid rgba(84, 125, 98, .2); border-radius: 9px; background: rgba(255, 255, 255, .58); color: #397451; font-size: 9px; font-weight: 800; line-height: 1; cursor: pointer; transition: background .14s ease, border-color .14s ease; }
.voice-note-meta > button:hover { border-color: rgba(45, 127, 77, .45); background: #fff; }
.message-mine .voice-note-heading { color: #3c7552; }
.message-mine .voice-note-meta { color: #466957; }
.message-mine .voice-waveform i { background: #8eae97; }
.message-mine .voice-waveform i.is-played { background: #168447; }
.message-has-voice { animation: voice-bubble-in .2s ease-out; }
.message-has-voice .message-read-receipt.is-read,
.message-has-voice .message-read-receipt.is-read svg { color: #1687e8; stroke: #1687e8; }
@keyframes voice-bubble-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
@keyframes voice-play-pulse { from { opacity: .8; transform: scale(.92); } to { opacity: 0; transform: scale(1.18); } }

.messenger-shell[data-theme="dark"] .voice-recording-indicator { background: #fff; color: #333; }
.messenger-shell[data-theme="dark"] .voice-note-player { border-color: #34483a; background: linear-gradient(145deg, #25372b, #1e3025); }
.messenger-shell[data-theme="dark"] .message-mine .voice-note-player { border-color: #286448; background: linear-gradient(145deg, #214a32, #183e29); }
.messenger-shell[data-theme="dark"] .voice-play-button { background: #20945c; }
.messenger-shell[data-theme="dark"] .voice-waveform i { background: #718d78; }
.messenger-shell[data-theme="dark"] .voice-waveform i.is-played { background: #69ca8a; }
.messenger-shell[data-theme="dark"] .voice-note-heading,
.messenger-shell[data-theme="dark"] .message-mine .voice-note-heading { color: #b0cfb8; }
.messenger-shell[data-theme="dark"] .voice-note-meta,
.messenger-shell[data-theme="dark"] .message-mine .voice-note-meta { color: #b4c8b9; }
.messenger-shell[data-theme="dark"] .voice-note-meta > button { border-color: #49644f; background: rgba(20, 39, 26, .65); color: #bce7c3; }
@media (max-width: 420px) {
  .voice-recording-indicator { gap: 7px; margin-inline: 10px; padding-inline: 8px; }
  .voice-cancel-button { width: 26px; flex-basis: 26px; }
  .recording-waveform { min-width: 32px; }
  .recording-hint { font-size: 10px; }
  .voice-note-player { min-width: 214px; gap: 9px; padding: 10px 11px; }
  .voice-play-button { width: 36px; height: 36px; flex-basis: 36px; }
}

/* Composer tools */
.composer-tool {
  background: transparent;
  border: none;
  color: #5a6a7e;
  cursor: pointer;
  padding: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background 0.15s ease, color 0.15s ease;
}
.composer-tool:hover {
  background: #eef2f8;
  color: #2196F3;
}
.voice-record-button {
  background: #2196F3;
  border: none;
  color: #fff;
  cursor: pointer;
  padding: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  width: 36px;
  height: 36px;
  transition: transform 0.15s ease, background 0.15s ease;
}
.voice-record-button:active {
  transform: scale(0.92);
  background: #1976D2;
}
.composer-emoji-picker {
  position: absolute;
  bottom: 70px;
  left: 12px;
  right: 12px;
  background: #fff;
  border: 1px solid #e0e6ef;
  border-radius: 12px;
  padding: 8px;
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 4px;
  box-shadow: 0 8px 24px rgba(25, 42, 64, 0.16);
  z-index: 10;
}
.composer-emoji-picker button {
  background: transparent;
  border: none;
  font-size: 22px;
  cursor: pointer;
  padding: 4px;
  border-radius: 6px;
  transition: background 0.12s ease;
}
.composer-emoji-picker button:hover {
  background: #eef2f8;
}
.attachment-draft {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  background: #f3f6fa;
  border-top: 1px solid #e0e6ef;
  color: #2c3e50;
  font-size: 13px;
}
.attachment-draft strong {
  display: block;
  font-size: 13px;
}
.attachment-draft small {
  color: #7a8a9e;
  font-size: 11px;
}